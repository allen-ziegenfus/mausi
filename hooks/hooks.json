{
  "hooks": {
    "Notification": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mausi-hook\" notify" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mausi-hook\" clear" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mausi-hook\" idle" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mausi-hook\" busy" },
        { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/src/mausi-guard\"", "timeout": 5 }
      ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/src/mausi-autosave\"", "timeout": 10 } ] }
    ]
  }
}
