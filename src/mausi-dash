ANSI = re.compile(r"(\033\[[0-9;]*m)")
# Below this width the two views are shown one at a time instead of side by side.
TWO_COLUMN_WIDTH = 140


def char_width(ch):
    if unicodedata.combining(ch) or ch in "‍︎️":
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def cells(text):
    """(char, width) pairs; a char followed by U+FE0F (emoji presentation,
    e.g. ❣️) is drawn two cells wide whatever its own width."""
    out = []
    for i, ch in enumerate(text):
        w = char_width(ch)
        if w == 1 and text[i + 1:i + 2] == "\ufe0f":
            w = 2
        out.append((ch, w))
    return out


def visible_len(s):
    # Terminal cells, not characters: emoji like 🎯 take two.
    return sum(w for _, w in cells(ANSI.sub("", s)))


def clip(s, width):
    """Cut s to width cells (keeping colour codes), with … when cut."""
    if visible_len(s) <= width:
        return s
    out, n = [], 0
    for token in ANSI.split(s):
        if token.startswith("\033"):
            out.append(token)
            continue
        for ch, w in cells(token):
            if n + w > width - 1:
                out.append("…")
                return "".join(out) + RESET
            out.append(ch)
            n += w
    return "".join(out) + RESET


def fit(s, width):
    """clip, then pad with spaces to exactly width cells."""
    s = clip(s, width)
    return s + RESET + " " * max(0, width - visible_len(s))


def load_dismissed():
    try:
        with open(DISMISSED) as f:
            d = json.load(f)
        return {"before": d.get("before", 0), "ids": set(d.get("ids", []))}
    except (OSError, ValueError):
        return {"before": 0, "ids": set()}


def save_dismissed(d):
    # Keep only ids newer than the clear-all line and the zoom window.
    window = max(NOTIFY_ZOOM_WINDOW, SLACK_ZOOM_WINDOW)
    keep = [i for i in d["ids"] if float(i.split("|", 1)[0]) > max(d["before"], time.time() - window)]
    write_atomic(DISMISSED, json.dumps({"before": d["before"], "ids": keep}))


def dismiss(note_id=None):
    d = load_dismissed()
    if isinstance(note_id, list):  # a whole Slack conversation
        d["ids"].update(note_id)
    elif note_id:
        d["ids"].add(note_id)
    else:
        d["before"] = time.time()
    save_dismissed(d)


def close_desktop(ids):
    """Close the desktop notifications (server ids from mausi-notif-capture),
    in the background; ids the server no longer has are ignored."""
    ids = [i for i in ids or [] if isinstance(i, int)]
    if not ids:
        return

    def run_close():
        for i in ids:
            subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                            "--object-path", "/org/freedesktop/Notifications",
                            "--method", "org.freedesktop.Notifications.CloseNotification", str(i)],
                           capture_output=True, timeout=5)
    threading.Thread(target=run_close, daemon=True).start()


def recent_notification_ids(window=NOTIFY_ZOOM_WINDOW):
    """Server ids of everything captured in the window, for D (dismiss all)."""
    now = time.time()
    return [n["id"] for n in notification_items() if now - n["ts"] <= window and n.get("id") is not None]


def notification_items(history=False):
    """Captured notifications, newest first: the collector's last 3 days, or
    for history (a search in the zoomed view) the whole log, read here."""
    if history:
        return context.read_notifications(window=10 * 365 * 86400, size=64 << 20)
    return (ctx.data("notifications") or {}).get("items", []) if ctx else []


def notification_lines(detail=False, width=None, history=False):
    """history: the whole capture log (a search in the zoomed view), not the
    last 24 hours."""
    window = 10 * 365 * 86400 if history else NOTIFY_ZOOM_WINDOW if detail else NOTIFY_WINDOW
    limit = NOTIFY_HISTORY_MAX if history else NOTIFY_ZOOM_MAX if detail else NOTIFY_MAX
    now = time.time()
    events = []
    for n in notification_items(history):
        ts, label, url, body = n["ts"], n["label"], n["url"], n["body"]
        if now - ts > window:
            break
        if n["app"] in NOTIFY_SKIP:
            continue
        if label == "Slack":
            continue  # they have their own section
        key = (label, n.get("summary", ""), body)
        if events and events[-1]["key"] == key:
            # Chromium posts most notifications twice within a second or two;
            # count those once.
            if events[-1]["last"] - ts > 3:
                events[-1]["count"] += 1
            events[-1]["last"] = ts
            events[-1]["ids"].append(n.get("id"))
            continue
        if len(events) >= limit:
            break
        events.append({"key": key, "ts": ts, "last": ts, "label": label, "url": url, "count": 1, "ids": [n.get("id")],
                       "summary": n.get("summary", ""), "body": body})

    dismissed = load_dismissed()
    for e in events:
        e["id"] = f"{e['ts']:.0f}|{e['label']}|{e['summary']}"
        e["dismissed"] = e["ts"] <= dismissed["before"] or e["id"] in dismissed["ids"]
    hidden = sum(1 for e in events if e["dismissed"])
    if not detail:
        events = [e for e in events if not e["dismissed"]]

    span = "the whole log" if history else f"last {window // 3600}h"
    hint = "" if history else " · / searches the whole log, e.g. /fri or /10-23" if detail else " · z for 24h"
    lines = [(f"{BOLD}Notifications{RESET} {DIM}({span}"
              + (f" · {hidden} dismissed" if hidden else "") + f"{hint}){RESET}", None)]
    for e in events:
        fresh = now - e["ts"] < NOTIFY_FRESH and not e["dismissed"]
        color = "" if fresh else DIM
        count = f" {DIM}×{e['count']}{RESET}" if e["count"] > 1 else ""
        # Fixed-width app column with a gap after it: longer names ("1Password",
        # "mausi-test") used to run straight into the title.
        label = e["label"] if len(e["label"]) <= 10 else e["label"][:9] + "…"
        body = f"  {DIM}{e['body']}{RESET}" if e["body"] and not detail else ""
        if detail:
            day = time.strftime("%a %m-%d " if now - e["ts"] > 12 * 3600 else "", time.localtime(e["ts"]))
        else:
            day = ""
        lines.append((f"  {DIM}{day}{time.strftime('%H:%M', time.localtime(e['ts']))}{RESET} "
                      f"{CYAN if fresh else DIM}{label:<10}{RESET} {color}{e['summary']}{RESET}{count}{body}",
                      {"open": e["url"], "notification": e["id"], "close": e["ids"],
                       "task_seed": {"title": f"Follow up: {e['summary']}", "source": e["label"],
                                     "context": [f"From a {e['label']} notification, "
                                                 f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(e['ts']))}: "
                                                 f"{e['summary']}" + (f" — {e['body'][:400]}" if e["body"] else "")]},
                       "detail": (f"{e['label']} · {time.strftime('%a %m-%d %H:%M', time.localtime(e['ts']))}"
                                                    + (f" · ×{e['count']}" if e["count"] > 1 else ""),
                                                    e["summary"] + ("\n\n" + e["body"] if e["body"] else ""))}))
        if detail and e["body"]:
            lines += sub(e["body"], width, indent=10)
    if not events:
        lines.append((f"  {DIM}nothing new{' — d/D dismissed the rest' if hidden else ''}{RESET}", None))
    return lines


def slack_messages(window):
    """Slack notifications captured from Chromium, newest first, one per
    message (Chromium repeats a notification, sometimes minutes apart, so the
    same text in the same conversation counts once): {ts, id, conversation,
    dm, sender, text, mention, dismissed}."""
    now = time.time()
    out, seen = [], {}
    for n in notification_items():
        ts, label, body = n["ts"], n["label"], n["body"]
        if now - ts > window:
            break
        if label != "Slack":
            continue
        summary = n.get("summary", "")
        if (summary, body) in seen:
            seen[(summary, body)]["ids"].append(n.get("id"))  # a repeat: close it too
            continue
        dm = re.match(r"New message from (.+)", summary)
        channel = re.match(r"New message in (.+)", summary)
        conversation = dm.group(1) if dm else channel.group(1) if channel else summary
        sender, text = (dm.group(1), body) if dm else (None, body)
        said = re.match(r"([^:]{2,40}): (.*)", body)
        if not dm and said:
            sender, text = said.groups()
        out.append({"ts": ts, "id": f"{ts:.0f}|Slack|{summary}", "conversation": conversation,
                    "dm": bool(dm), "sender": sender, "text": text,
                    "mention": f"@{SLACK_ME}" in body, "ids": [n.get("id")]})
        seen[(summary, body)] = out[-1]
    dismissed = load_dismissed()
    for m in out:
        m["dismissed"] = m["ts"] <= dismissed["before"] or m["id"] in dismissed["ids"]
    return out


def slack_task_seed(name, latest, msgs):
    """What t offers for a Slack conversation: a PR URL or Jira key from the
    latest message (looked up like a typed one), else a follow-up line. The
    message goes into the task as context, with the ones just before it in a
    DM (same half hour), oldest first."""
    where = f"DM with {name}" if latest["dm"] else name
    pr = PR_URL_RE.search(latest["text"])
    key = TICKET_ANY_RE.search(latest["text"]) if not pr else None
    who = latest["sender"] or name
    if pr:
        title = "https://github.com/{}/{}/pull/{}".format(*pr.groups())
    elif key:
        title = key.group(0)
    else:
        snippet = " ".join(latest["text"].split()[:10])
        title = f"Follow up with {who}" + (" (DM)" if latest["dm"] else f" in {name}") + f": {snippet}"
    related = [m for m in msgs if latest["dm"] and latest["ts"] - m["ts"] < 1800][:5] or [latest]
    context = [f"From Slack, {where}, {time.strftime('%Y-%m-%d %H:%M', time.localtime(m['ts']))}: "
               + (f"{m['sender']}: " if m["sender"] and not m["dm"] else "") + m["text"][:400]
               for m in reversed(related)]
    return {"title": title, "source": "Slack", "context": context}


def slack_lines(detail=False, width=None):
    """Slack, from its desktop notifications (DMs, mentions, keywords and
    whatever channels notify): one row per conversation, newest first."""
    now = time.time()
    messages = slack_messages(SLACK_ZOOM_WINDOW if detail else SLACK_WINDOW)
    if not detail:
        messages = [m for m in messages if not m["dismissed"]]
    conversations = {}
    for m in messages:
        conversations.setdefault(m["conversation"], []).append(m)
    head = (f"{BOLD}Slack{RESET} {DIM}(from notifications · last {(SLACK_ZOOM_WINDOW if detail else SLACK_WINDOW) // 3600}h"
            + ("" if detail else " · z for 3 days") + f"){RESET}")
    lines = [(head, None)]
    for name, msgs in list(conversations.items())[:None if detail else SLACK_MAX]:
        latest = msgs[0]
        live = [m for m in msgs if not m["dismissed"]]
        loud = latest["dm"] or any(m["mention"] for m in live)
        fresh = now - latest["ts"] < NOTIFY_FRESH and live
        when = time.strftime("%a %H:%M" if now - latest["ts"] > 12 * 3600 else "%H:%M", time.localtime(latest["ts"]))
        title = ("DM · " if latest["dm"] else "") + name
        style = BOLD if loud and live else "" if live else DIM
        mark = f"{YELLOW}@{RESET}" if any(m["mention"] for m in live) else " "
        count = f" {DIM}×{len(msgs)}{RESET}" if len(msgs) > 1 else ""
        preview = ((latest["sender"] + ": ") if latest["sender"] and not latest["dm"] else "") + (
            latest["text"] or "(no preview)")
        history = "\n".join(
            f"{time.strftime('%a %H:%M', time.localtime(m['ts']))}  "
            + (f"{m['sender']}: " if m["sender"] else "") + m["text"] for m in msgs)
        action = {"open": "https://app.slack.com/client", "notification": [m["id"] for m in msgs],
                  "close": [i for m in msgs for i in m["ids"]],
                  "task_seed": slack_task_seed(name, latest, msgs),
                  "detail": (f"Slack · {title} · {len(msgs)} message{'s' if len(msgs) > 1 else ''}", history)}
        lines.append((f"  {DIM}{when:>9}{RESET} {mark}{CYAN if fresh else ''}{style}{fit(title, 26)}{RESET}{count} "
                      f"{DIM}{preview}{RESET}", action))
        if detail:
            for m in msgs[1:4]:
                lines += sub((f"{m['sender']}: " if m["sender"] and not m["dm"] else "") + m["text"], width, indent=13)
    if len(lines) == 1:
        lines.append((f"  {DIM}nothing new{RESET}", None))
    return lines


