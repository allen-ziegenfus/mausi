def pod_age(stamp):
    # Kubernetes timestamps are UTC ("2026-10-21T16:24:03Z").
    secs = time.time() - calendar.timegm(time.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ"))
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 86400:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 86400)}d"


def section(lines, name):
    """Tag a section's rows with its name (for z) and make its heading
    selectable, so Enter on the heading zooms into it."""
    out = []
    for i, (text, action) in enumerate(lines):
        if action:
            action = {**action, "section": name}
        elif i == 0 and text:
            action = {"section": name, "zoom": True}
        out.append((text, action))
    return out


def sub(text, width=None, indent=6):
    """Dim detail line(s) under a row; wrapped when width is given."""
    pad = " " * indent
    if not width:
        return [(f"{pad}{DIM}{text}{RESET}", None)]
    return [(f"{pad}{DIM}{line}{RESET}", None)
            for line in textwrap.wrap(text, max(20, width - indent - 2)) or [""]]


def midnight(days_ago=0):
    return time.mktime(time.localtime(time.time() - days_ago * 86400)[:3] + (0, 0, 0, 0, 0, -1))


def my_message_times():
    """Epoch seconds of this week's (since Monday) messages typed to Claude in
    any session (tool results, which arrive while I'm away, don't count)."""
    start = midnight(time.localtime().tm_wday)
    stamps = []
    for root, _, files in os.walk(PROJECTS):
        for name in files:
            path = os.path.join(root, name)
            try:
                if not name.endswith(".jsonl") or os.path.getmtime(path) < start:
                    continue
                f = open(path, errors="ignore")
            except OSError:  # Claude Code removed it meanwhile
                continue
            with f:
                for line in f:
                    if '"type":"user"' not in line and '"type": "user"' not in line:
                        continue
                    try:
                        ev = json.loads(line)
                    except ValueError:
                        continue
                    if ev.get("type") != "user" or ev.get("isMeta"):
                        continue
                    content = (ev.get("message") or {}).get("content")
                    if isinstance(content, list) and any(
                            isinstance(c, dict) and c.get("type") == "tool_result" for c in content):
                        continue
                    try:
                        ts = calendar.timegm(time.strptime(ev["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
                    except (KeyError, ValueError):
                        continue
                    if ts >= start:
                        stamps.append(ts)
    return sorted(stamps)


def computer_intervals():
    """[(start, end)] of this week's time at the computer, from ACTIVITY_LOG; None
    when the logger has never run. A trailing "active" runs until now."""
    try:
        with open(ACTIVITY_LOG) as f:
            marks = [(int(p[0]), p[1]) for p in (line.split() for line in f)
                     if len(p) == 2 and p[0].isdigit()]  # a torn line (a crash mid-write) is skipped
    except (OSError, ValueError):
        return None
    week = midnight(time.localtime().tm_wday)
    out, since = [], None
    for when, state in marks:
        if state == "active" and since is None:
            since = when
        elif state == "idle" and since is not None:
            if when > since and when > week:
                out.append((max(since, week), when))
            since = None
    if since is not None:
        out.append((max(since, week), time.time()))
    return out


def call_intervals():
    """[(start, end)] of this week's calls: the mic in use, as mausi-activity
    logs it (call-start / call-end); an open one runs until now."""
    try:
        with open(ACTIVITY_LOG) as f:
            marks = [(int(p[0]), p[1]) for p in (line.split() for line in f)
                     if len(p) == 2 and p[0].isdigit()]  # a torn line (a crash mid-write) is skipped
    except (OSError, ValueError):
        return []
    week = midnight(time.localtime().tm_wday)
    out, since = [], None
    for when, state in marks:
        if state == "call-start" and since is None:
            since = when
        elif state == "call-end" and since is not None:
            if when > week:
                out.append((max(since, week), when))
            since = None
    if since is not None:
        out.append((max(since, week), time.time()))
    return out


def is_meeting(e):
    """A timed event with other people or a Meet link; personal appointments (no
    attendees, no Meet: school pick-up, Gmail events) aren't meetings."""
    return not e.get("allday") and e.get("meeting", True)


def meeting_intervals():
    """[(start, end, title)] of today's timed meetings from the calendar command (declined
    ones are already left out; personal appointments too)."""
    with lock:
        events = (meetings or {}).get("events", [])
    out = []
    for e in events:
        if not is_meeting(e):
            continue
        try:
            out.append((parse_time(e["start"]), parse_time(e["end"]), e.get("title", "")))
        except (KeyError, ValueError):
            continue
    return out


def merge_intervals(intervals):
    """Overlapping or touching (start, end) spans joined into one."""
    out = []
    for a, b in sorted(intervals):
        if out and a <= out[-1][1]:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return out


def logged_since():
    """When the activity log starts; earlier days have no computer time to show."""
    try:
        with open(ACTIVITY_LOG) as f:
            return int(f.readline().split()[0])
    except (OSError, ValueError, IndexError):
        return None


def computer_time(intervals, start, end):
    return sum(max(0, min(b, end) - max(a, start)) for a, b in intervals)


BREAK_SNOOZE = os.path.join(cfg.CACHE_DIR, "break-snooze")  # epoch; written by mausi-break


def maybe_remind_break(act):
    """Open mausi-break fullscreen once I've gone BREAK_DUE without a break
    (calls and meetings don't count), unless it is snoozed. The snooze is set
    before opening, so a second dashboard (or a closed window) can't stack them."""
    with lock:
        calendar_loaded = meetings.get("synced") is not None or meetings.get("error") is not None
    if not calendar_loaded:
        return  # don't count an unread meeting as work
    now = time.time()
    b = break_status(act, now)
    if b["kind"] != "working" or b["run_for"] < BREAK_DUE:
        return
    try:
        with open(BREAK_SNOOZE) as f:
            if now < float(f.read().strip() or 0):
                return
    except (OSError, ValueError):
        pass
    write_atomic(BREAK_SNOOZE, str(int(now + 15 * 60)))
    subprocess.run(["kitty", "@", "launch", "--type=os-window", "--os-window-state=fullscreen",
                    "--title", "Take a break", os.path.join(os.path.dirname(os.path.realpath(__file__)), "mausi-break"),
                    "--since", str(int(b["since"]))], capture_output=True)


MEETING_LEAD = 2 * 60   # announce a meeting this long before it starts
MEETING_LATE = 5 * 60   # still announce it this long after (dashboard started late)
MEETING_REMINDED = os.path.join(cfg.CACHE_DIR, "meeting-reminded.json")  # {"<start> <title>": epoch}


def maybe_remind_meeting():
    """Open the reminder screen fullscreen for a timed calendar event starting
    within MEETING_LEAD, once per event (remembered before opening, so a second
    dashboard can't open it again)."""
    now = time.time()
    with lock:
        events = [e for e in meetings.get("events", []) if is_meeting(e)]
    due = [e for e in events if -MEETING_LATE < parse_time(e["start"]) - now <= MEETING_LEAD]
    if not due:
        return
    try:
        reminded = json.load(open(MEETING_REMINDED))
    except (OSError, ValueError):
        reminded = {}
    reminded = {k: v for k, v in reminded.items() if v > now - 86400}
    for e in due:
        name = f"{e['start']} {e['title']}"
        if name in reminded:
            continue
        reminded[name] = parse_time(e["start"])
        write_atomic(MEETING_REMINDED, json.dumps(reminded))
        cmd = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "mausi-break"), "--meeting", e["title"],
               "--start", str(int(parse_time(e["start"]))), "--end", str(int(parse_time(e["end"])))]
        if e.get("meet"):
            cmd += ["--meet", e["meet"]]
        if e.get("location"):
            cmd += ["--where", e["location"]]
        subprocess.run(["kitty", "@", "launch", "--type=os-window", "--os-window-state=fullscreen",
                        "--title", f"Meeting: {e['title'][:60]}", *cmd], capture_output=True)
        return  # one at a time; the next one comes on the next pass


def ensure_helpers():
    """Keep the background helpers running (they outlive the dashboard and stop
    at logout): mausi-activity for the break timer (on Linux it needs swayidle),
    and mausi-notif-capture when [notifications] capture is on (Linux)."""
    here = os.path.dirname(os.path.realpath(__file__))
    if cfg.IS_MAC or shutil.which("swayidle"):
        cfg.ensure_background("mausi-activity", [os.path.join(here, "mausi-activity")])
    if cfg.get("notifications", "capture") and not cfg.IS_MAC and shutil.which("dbus-monitor"):
        cfg.ensure_background("mausi-notif-capture", [os.path.join(here, "mausi-notif-capture")])


def activity_loop(wake):
    """Every minute: the You section's data, the task store's upkeep, the
    session snapshot `mausi` restores from, and the reminders."""
    global activity_data
    while True:
        try:
            ensure_helpers()
            snapshots.write_snapshot()
        except Exception:  # noqa: BLE001
            pass
        data = {"stamps": my_message_times(), "computer": computer_intervals(), "calls": call_intervals(),
                "logged_since": logged_since()}
        with lock:
            activity_data = data
        try:
            store().sync()  # TASK.md files edited by hand or by a Claude session
            store().link_worktrees()  # <task>/code/ links, e.g. to a worktree w just made
            store().scan_sessions()  # my message times per session, for each task's effort
        except Exception:  # noqa: BLE001
            pass
        for remind in (maybe_remind_meeting, lambda: maybe_remind_break(data)):
            try:
                remind()
            except Exception:  # noqa: BLE001 — a reminder must never take the dashboard down
                pass
        wake.wait(60)
        wake.clear()


def energy_entries():
    """[{when, activity, state, valence, note}] in file order (oldest first)."""
    out, cur = [], None
    for line in read_lines(ENERGY_LOG):
        m = re.match(r"### (\d{4}-\d\d-\d\d)(?: [~\d:]+)? — (.*)", line)
        if m:
            cur = {"when": m.group(1), "activity": m.group(2).strip(), "state": "", "valence": "", "note": []}
            out.append(cur)
        elif cur is not None:
            kv = re.match(r"\*\*(state|valence)\*\*: *(.*)", line)
            if kv:
                cur[kv.group(1)] = kv.group(2).strip()
            elif line.strip() and not line.startswith("#"):
                cur["note"].append(line.strip())
    return out


def log_energy(activity, state, valence):
    append_text(ENERGY_LOG, f"\n### {time.strftime('%Y-%m-%d %H:%M')} — {activity}\n**state**: {state}\n**valence**: {valence}\n")


def active_time(stamps):
    """Gaps between my messages up to ACTIVE_GAP, summed."""
    return sum(b - a for a, b in zip(stamps, stamps[1:]) if b - a <= ACTIVE_GAP)


def span(secs):
    return f"{int(secs // 3600)}h{int(secs % 3600 // 60):02d}m" if secs >= 3600 else f"{int(secs // 60)}m"


def break_status(act, now):
    """Where I am with breaks: {"kind": "call" | "meeting" | "break" | "working",
    "since", "run_for", "idle", "title"} from keyboard/mouse activity, calls,
    today's meetings and (without the activity log) my messages to Claude."""
    today = midnight()
    stamps = [t for t in act["stamps"] if t >= today]
    # Active spans: keyboard/mouse use from mausi-activity when it is
    # logging (time away from Claude isn't a break if I'm still at the
    # computer), else my messages to Claude as points. Calls (mic in use) and
    # today's meetings count as active too: sitting still in a meeting isn't a break.
    in_meetings = [(a, min(b, now)) for a, b, _ in meeting_intervals() if a < now]
    spans = merge_intervals([(max(a, today), b) for a, b in (act["computer"] or []) + act.get("calls", [])
                             + in_meetings if b > today])
    if not spans:
        spans = [(t, t) for t in stamps]
    if not spans:
        return {"kind": None}
    # Walk back from the latest span while the gaps stay shorter than a break.
    start, end = spans[-1]
    for (a, b), (c, _) in zip(reversed(spans[:-1]), reversed(spans[1:])):
        if c - b >= BREAK_GAP:
            break
        start = a
    call = next((a for a, b in act.get("calls", []) if b >= now - 60), None)
    meeting = next(((a, title) for a, b, title in meeting_intervals() if a <= now < b), None)
    if call:
        return {"kind": "call", "since": call}
    if meeting:
        return {"kind": "meeting", "since": meeting[0], "title": meeting[1]}
    if now - end >= BREAK_GAP:
        return {"kind": "break", "idle": now - end}
    return {"kind": "working", "since": start, "run_for": now - start}


def you_lines(detail=False, width=None):
    with lock:
        act = activity_data
    now = time.time()
    lines = [(f"{BOLD}You{RESET}", None)]
    if act is None:
        lines.append((f"  {DIM}loading…{RESET}", None))
    else:
        today = midnight()
        stamps = [t for t in act["stamps"] if t >= today]
        if not stamps:
            lines.append((f"  {DIM}no messages to Claude yet today{RESET}", None))
        else:
            active = active_time(stamps)
            b = break_status(act, now)
            if b["kind"] == "call":
                state = f"{CYAN}in a call since {time.strftime('%H:%M', time.localtime(b['since']))} (mic in use){RESET}"
            elif b["kind"] == "meeting":
                state = (f"{CYAN}in a meeting since {time.strftime('%H:%M', time.localtime(b['since']))}: "
                         f"{b['title'][:50]}{RESET}")
            elif b["kind"] == "break":
                state = f"{GREEN}on a break — away {span(b['idle'])}{RESET}"
            else:
                run_for = b["run_for"]
                color = RED if run_for >= BREAK_DUE else YELLOW if run_for >= BREAK_WARN else GREEN
                due = "  take 5 minutes" if run_for >= BREAK_DUE else ""
                state = (f"{color}{span(run_for)} since your last break"
                         f" ({time.strftime('%H:%M', time.localtime(b['since']))}){due}{RESET}")
            late = time.localtime().tm_hour >= LATE_HOUR
            lines.append((f"  {state}", None))
            at = act["computer"]
            talk = merge_intervals(act.get("calls", []) + [(a, min(b, now)) for a, b, _ in meeting_intervals() if a < now])
            talk_today = computer_time(talk, today, now)
            computer = (f"{RESET}{span(computer_time(merge_intervals((at or []) + talk), today, now))}{DIM} active"
                        + (f" ({span(talk_today)} in calls/meetings)" if talk_today >= 60 else "") + " · "
                        if at is not None else "")
            lines.append((f"  {DIM}today: {computer}{span(active)} with Claude since "
                          f"{time.strftime('%H:%M', time.localtime(stamps[0]))}{RESET}"
                          + (f"  {YELLOW}it's after {LATE_HOUR}:00 — wrap up?{RESET}" if late else ""), None))
    if act is not None:
        # Per day, so an overnight gap never counts.
        days, end_of = [], {}
        for back in range(time.localtime().tm_wday, -1, -1):
            start, end = midnight(back), midnight(back - 1) if back else now
            end_of[time.strftime("%a", time.localtime(start))] = end
            days.append((time.strftime("%a", time.localtime(start)),
                         active_time([t for t in act["stamps"] if start <= t < end]),
                         computer_time(merge_intervals((act["computer"] or []) + act.get("calls", [])), start, end)))
        claude = span(sum(d[1] for d in days))
        if act["computer"] is not None:
            week = (f"  {DIM}this week: {RESET}{span(sum(d[2] for d in days))}{DIM} active"
                    f" · {claude} with Claude")
        else:
            week = f"  {DIM}this week: {RESET}{claude}{DIM} with Claude"
        lines.append((week + RESET, None))
        if detail:
            for day, secs, at in days:
                logged = act["logged_since"] is not None and act["logged_since"] < end_of[day]
                lines.append((f"    {DIM}{day}{RESET} " + (f"{span(at) if logged else '—':>6} active {DIM}·{RESET} "
                              if act["computer"] is not None else "") + f"{span(secs):>6} with Claude", None))
    if not ENERGY_LOG:
        return lines
    entries = energy_entries()
    monday = time.strftime("%Y-%m-%d", time.localtime(now - time.localtime().tm_wday * 86400))
    week = [e for e in entries if e["when"] >= monday]
    gave = sum(1 for e in week if e["valence"].startswith("gave"))
    took = sum(1 for e in week if e["valence"].startswith("took"))
    lines.append((f"  {DIM}energy this week:{RESET} {GREEN}{gave} gave{RESET} · {RED}{took} took{RESET}"
                  f"{DIM} · L to log how this feels{RESET}", None))
    marks = {"gave": f"{GREEN}+{RESET}", "took": f"{RED}−{RESET}"}
    for e in reversed(entries[-(12 if detail else 3):]):
        mark = marks.get(e["valence"][:4], f"{DIM}·{RESET}")
        lines.append((f"  {mark} {DIM}{e['when'][5:]}{RESET} {e['activity']}  {DIM}{e['state']}{RESET}",
                      {"detail": (f"{e['when']} · {e['state']} · {e['valence']}",
                                  e["activity"] + ("\n\n" + "\n".join(e["note"]) if e["note"] else ""))}))
        if detail and e["note"]:
            lines += sub(" ".join(e["note"]), width)
    return lines


def docker_lines(containers, detail=False):
