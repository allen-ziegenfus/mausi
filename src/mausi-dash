    return lines


def add_reminder(text):
    """A new reminder from "title [@list] [due today|tomorrow|YYYY-MM-DD]";
    @list may be the start of an existing list's name."""
    due, group = None, None
    m = re.search(r"\s+due\s+(today|tomorrow|\d{4}-\d{2}-\d{2})\s*$", text, re.I)
    if m:
        word = m.group(1).lower()
        due = {"today": time.strftime("%Y-%m-%d"),
               "tomorrow": time.strftime("%Y-%m-%d", time.localtime(time.time() + 86400))}.get(word, word)
        text = text[:m.start()]
    m = re.search(r"(?:^|\s)@(\S+)", text)
    if m:
        with lock:
            groups = sorted({r.get("group") for r in (reminders or {}).get("items", []) if r.get("group")})
        want = m.group(1).lower()
        hits = [g for g in groups if g.lower() == want] or [g for g in groups if g.lower().startswith(want)]
        if len(hits) != 1:
            return f"no single list matches @{m.group(1)}" + (f": {', '.join(hits[:5])}" if hits else "")
        group = hits[0]
        text = (text[:m.start()] + text[m.end():])
    title = " ".join(text.split())
    if not title:
        return "no title: nothing added"
    cmd = REMINDERS_CMD + ["--add", title] + (["--group", group] if group else []) + (["--due", due] if due else [])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        return "couldn't add it: the reminders command took over 10 s"
    if r.returncode != 0:
        return f"couldn't add it: {(r.stderr or r.stdout).strip()[:80]}"
    if ctx:
        ctx.refresh("reminders")
    return f"added: {title[:50]}" + (f" in {group}" if group else "") + (f", due {due}" if due else "")


def ago(epoch):
    if not epoch:
        return "—"
    s = max(0, time.time() - epoch)
    return (f"{int(s // 60)}m" if s < 3600 else f"{int(s // 3600)}h" if s < 86400
            else f"{int(s // 86400)}d" if s < 60 * 86400 else f"{int(s // (30 * 86400))}mo")


def session_in(path, rows):
    """The session row running in path (or a folder under it), the deepest
    match first, so a worktree inside its repo isn't claimed by the repo."""
    best, depth = None, -1
    for r in rows:
        cwd = r.get("cwd_real") or os.path.realpath(r.get("cwd_full") or "")
        if (cwd == path or cwd.startswith(path + os.sep)) and len(cwd) > depth:
            best, depth = r, len(cwd)
    return best


def project_action(p, row):
    """Enter on a project or worktree: its session if one is open, else Claude
    in a new tab there (continuing the folder's last conversation)."""
    action = {"shell": ["--cwd", p["path"]], "name": p["name"],
              "detail": (p["path"], f"{p['path']}\n\n" + (f"branch {p['branch']} · {p['changes']} uncommitted"
                                                           if p["git"] else "not a git repo")
                         + f" · last change {ago(p['last'])} ago"
                         + "".join(f"\n{t['id']} {t['title']}" for t in p.get("tasks", [])))}
    if row:
        action.update({"tab": row["tab_id"], "sid": row["sid_full"], "cwd": row["cwd_full"],
