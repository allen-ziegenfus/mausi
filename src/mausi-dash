def notes_lines(detail=False, width=None):
    sn, qn = snippets(), quick_notes()
    lines = [(f"{BOLD}Notes{RESET} {DIM}({len(sn)} snippets · {len(qn)} quick notes"
              f"{'' if detail else ' · z for all'}){RESET}", None)]
    shown_sn = sn if detail else sn[-NOTES_SNIPPETS_MAX:]
    for x in reversed(shown_sn):
        first = x["body"].splitlines()[0] if x["body"] else ""
        lines.append((f"  {CYAN}⧉{RESET} {x['title']}  {DIM}{first}{RESET}",
                      {"copy": x["body"], "copy_name": x["title"], "detail": (x["title"], x["body"]),
                       "edit": (SNIPPETS_MD, x["line"]), "delete": (SNIPPETS_MD, x["line"], x["title"])}))
        if detail and len(x["body"].splitlines()) > 1:
            lines += sub(" ⏎ ".join(x["body"].splitlines()[1:4])[:200])
    if len(sn) > len(shown_sn):
        lines.append((f"  {DIM}… {len(sn) - len(shown_sn)} more snippets (z){RESET}", None))
    today = time.strftime("%Y-%m-%d")
    for q in (qn if detail else qn[:NOTES_QUICK_MAX]):
        when = q["ts"][11:] if q["ts"].startswith(today) else q["ts"][5:]
        lines.append((f"  {DIM}{when}{RESET} {q['text']}",
                      {"copy": q["text"], "copy_name": "note", "detail": (q["ts"], q["text"]),
                       "edit": (QUICK_MD, q["line"]), "delete": (QUICK_MD, q["line"], q["text"])}))
    if not sn and not qn:
        lines.append((f"  {DIM}b: save the clipboard as a snippet · n: quick note{RESET}", None))
    return lines


