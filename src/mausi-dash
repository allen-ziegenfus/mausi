        lines[0] = (lines[0][0] + f" {DIM}· {hidden} done{RESET}", None)
    if t.get("summary"):
        lines += [(f"  {DIM}{l}{RESET}", None) for l in textwrap.wrap(t["summary"], max(30, (width or 100) - 4))[:None if detail else 2]]
