# Keys work with or without Shift (a missed Shift never does something else),
# except these: D (dismiss all) is the bigger version of d, and l already moves
# right, so L (log energy) needs the Shift.
CASED_KEYS = ("D", "L", "R")
KEY_RE = re.compile(r"\033\[<[0-9;]*[mM]|\033\[[0-9;]*[~A-Za-z]|\033O[A-Z]|\033|.", re.S)
# An escape sequence that hasn't ended yet, at the end of what was read.
PARTIAL_RE = re.compile(rb"\033(?:\[<?[0-9;]*|O)?$")
# SGR mouse report: ESC [ < button ; column ; row M. Buttons 64/65 are the wheel.
MOUSE_RE = re.compile(r"\033\[<(\d+);(\d+);(\d+)[mM]")


def mouse_key(seq):
    """"wheelup:<column>" / "wheeldown:<column>" for the wheel, "" for clicks."""
    m = MOUSE_RE.fullmatch(seq)
    if m and int(m.group(1)) in (64, 65):
        return f"{'wheelup' if m.group(1) == '64' else 'wheeldown'}:{m.group(2)}"
    return ""


def read_keys(fd):
    # Read the raw fd, not sys.stdin: the buffered reader would swallow the
    # rest of an escape sequence (ESC [ A) after the first byte, so select()
    # never sees it. One read can hold several keypresses (key repeat, fast
    # typing), so it is split into keys.
    # A fast mouse wheel sends a burst of reports; a read can end in the middle
    # of one, and its tail ("5;30;12M") would come out as keys: digits switch
    # tabs. So an escape sequence cut off at the end is completed first (a lone
    # Esc, with nothing after it, stays the Esc key).
    data = os.read(fd, 4096)
    while PARTIAL_RE.search(data) and select.select([fd], [], [], 0.05)[0]:
        more = os.read(fd, 4096)
        if not more:
            break
        data += more
    tail = PARTIAL_RE.search(data)
    if tail and tail.group(0) != b"\033":  # still cut off: drop the fragment rather than type it
        data = data[:tail.start()]
    data = data.decode(errors="ignore")
    return [k if k == "\033" else mouse_key(k) if k.startswith("\033[<")
            else KEYS.get(k, "") if k.startswith("\033") else k
            for k in KEY_RE.findall(data)]


# --- restart on change -------------------------------------------------------
# The dashboard runs for days; when its code (src/, bin/) or config.toml
# changes, it starts itself again (exec, same tab), in the same view. It waits
# until the files have been quiet for RESTART_SETTLE seconds (a git pull writes
# many) and the Python in them compiles, so a half-saved file doesn't kill it.
RESTART_SETTLE = 2
_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def code_stamp():
    stamp = {}
    for d in ("src", "bin"):
        try:
            names = os.listdir(os.path.join(_ROOT, d))
        except OSError:
            continue
        for name in names:
            path = os.path.join(_ROOT, d, name)
            if name.endswith((".pyc", "~", ".swp")) or not os.path.isfile(path):
                continue
            stamp[path] = os.stat(path).st_mtime_ns
    try:
        stamp[cfg.CONFIG_PATH] = os.stat(cfg.CONFIG_PATH).st_mtime_ns
    except OSError:
        pass
    return stamp


def _is_python(path):
    if path.endswith(".py"):
        return True
    try:
        with open(path, "rb") as f:
            return b"python" in f.readline()
    except OSError:
        return False


def restart_check(state):
    """Called each poll; state is {"stamp", "pending", "since", "bad"}. Returns
    True when it's time to restart."""
    now = code_stamp()
    if now == state["stamp"]:
        state["pending"] = None
        return False
    if now != state.get("pending"):  # still changing: wait for it to settle
        state["pending"], state["since"] = now, time.time()
        return False
    if time.time() - state["since"] < RESTART_SETTLE:
        return False
    changed = [p for p in now if now.get(p) != state["stamp"].get(p)]
    for path in changed:
        if path == cfg.CONFIG_PATH or not _is_python(path):
            continue
        try:
            with open(path, encoding="utf-8") as f:
                compile(f.read(), path, "exec")
        except (SyntaxError, ValueError, OSError) as e:
            if state.get("bad") != (path, now.get(path)):
                state["bad"] = (path, now.get(path))
                cfg.log_error("restart", f"not restarting: {os.path.basename(path)} doesn't compile: {e}")
            return False
    # Compiling isn't enough: a module can still fail when it's imported (or
    # a config value can be wrong). Start the new code once with --check,
    # which loads everything and exits; only restart if that works.
    if state.get("bad") == ("check", now):  # this version already failed: wait for the next change
        return False
    try:
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "--check"],
                           capture_output=True, text=True, timeout=30)
        ok, why = r.returncode == 0, (r.stderr.strip().splitlines() or ["exit %d" % r.returncode])[-1]
    except (OSError, subprocess.TimeoutExpired) as e:
        ok, why = False, str(e)
    if not ok:
        if state.get("bad") != ("check", now):
            state["bad"] = ("check", now)
            cfg.log_error("restart", f"not restarting: the new code fails to start: {why}")
        return False
    return True


def restart(ui):
    """exec this script again, in the view that's open."""
    view = "tasks" if ui.tasks else VIEWS[ui.view].lower()
    args, skip = [], False
    for a in sys.argv[1:]:  # everything but an earlier --view <name>
        if skip or a == "--view":
            skip = not skip
            continue
        args.append(a)
    os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), *args, "--view", view])


def start_view():
    """--view work/tasks: the view to start in."""
    if "--view" in sys.argv[1:-1]:
        name = sys.argv[sys.argv.index("--view") + 1].capitalize()
        return "tasks" if name == "Tasks" else VIEWS.index(name) if name in VIEWS else 0
    return 0


ctx = None  # mausi_context.Context: the one place the data comes from


class Wake:
    """What handle() sets to refresh a section now: asks the collector to
    fetch the source(s) behind it."""

    def __init__(self, *sources):
        self.sources = sources

    def set(self):
        for source in self.sources:
            ctx.refresh(source)


def on_context(name, entry):
    """A source has new data: hand it to the section globals the views read."""
    global work_data, infra_data, mail, reminders, projects_data, meetings, meetings_tomorrow
    data, error = entry.get("data"), entry.get("error")
    with lock:
        # An error shows as before, in place of the section; the collector
        # keeps the last good data in the file for triage.
        if name == "board":
            work_data = {"error": error} if error or data is None else data
        elif name == "infra":
            infra_data = data
        elif name == "mail":
            mail = {"unread": [], "error": error} if error or data is None else dict(data, error=None)
        elif name == "projects":
            projects_data = {"groups": [], "error": error} if error or data is None else dict(data, error=None)
        elif name == "reminders":
            # one command failing leaves the others' items, with the error shown
            reminders = {"items": [], "error": error} if data is None else dict(data, error=error)
        elif name == "calendar":
            today = (data or {}).get("today") or {"events": [], "synced": None}
            meetings = dict(today, error=error if not today.get("events") and error else None)
            meetings.setdefault("running", True)
            meetings_tomorrow = (data or {}).get("tomorrow") or {"events": []}


def start_loops():
    """Attach to the collector (mausi_context: run it here unless `mausi
    context --watch` or another dashboard does) and start the activity loop.
    Returns the wake objects (infra, work, meetings, activity) handle() sets
    to refresh now."""
    global ctx
    load_jira_cache()
    ctx = context.attach(on_context)
    activity = threading.Event()
    threading.Thread(target=keep_running, args=(activity_loop, activity), daemon=True).start()
    return (Wake("infra"), Wake("board"), Wake("calendar", "mail"), activity)


def keep_running(loop, wake):
    """Run a background loop; if it raises, log it and start it again a little
    later, so one bad file or answer doesn't stop that data for good."""
    while True:
        try:
            loop(wake)
            return
        except Exception:  # noqa: BLE001
            cfg.log_error(loop.__name__)
            time.sleep(10)


def main():
    view = start_view()
    wakes = start_loops()

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    sys.stdout.write("\033[?25l\033[?1000h\033[?1006h")  # hide cursor; report mouse buttons (wheel) as SGR
    ui = Ui(view)
    rows = []
    last_poll = 0
    code = {"stamp": code_stamp(), "pending": None}
    restarting = False
    try:
        while True:
            # Keypresses redraw immediately; the session list is re-polled
            # (kitty @ ls + git per tab) only every SESSION_REFRESH seconds.
            if time.time() - last_poll >= SESSION_REFRESH:
                if restart_check(code):
                    restarting = True
                    break
                rows = sessions()
                last_poll = time.time()
                threading.Thread(
                    target=fetch_jira, args=({r["ticket"] for r in rows},),
                    daemon=True).start()
            ui.draw(rows)
            pa = ui.popup[2] if ui.popup else {}
            loading = ((pa.get("issue") and issue_data(pa["issue"]) is None)
                       or (pa.get("pr") and detail_data(pr_path(pa["pr"])) is None))
            loading = loading or bool(_preview["busy"]) or bool(mail_search and mail_search["busy"])
            ready, _, _ = select.select([sys.stdin], [], [], 0.3 if loading else SESSION_REFRESH)
            if not ready:
                continue
            keys = read_keys(fd)
            quit_ = False
            for key in keys:
                if key.startswith("wheel"):
                    direction, column = key.split(":")
                    step = 1 if direction == "wheeldown" else -1  # kitty already sends several events per notch
                    if ui.mailbox:
                        ui.scroll_mail(step)
                    elif ui.popup:
                        ui.scroll_popup(step)
                    else:
                        ui.wheel(step, int(column))
                    continue
                if process_key(ui, key, wakes):
                    quit_ = True
                    break
            if quit_:
                break

    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?1006l\033[?1000l\033[?25h\033[H\033[2J")
        sys.stdout.flush()
    if restarting:
        restart(ui)


def process_key(ui, key, wakes):
    """One key (as read_keys gives it: a character, "\\r", "\\033", "up"…)
    for whatever is open: a y/N question, a prompt, the pop-up, else the
    view. Returns True for quit. The Textual dashboard (mausi-tui) feeds its
    keys through here too. An error is logged and shown, not fatal."""
    try:
        return _process_key(ui, key, wakes)
    except Exception as e:  # noqa: BLE001
        cfg.log_error(f"key {key!r}")
        ui.say(f"error: {type(e).__name__}: {str(e)[:80]} (details in {cfg.ERROR_LOG.replace(HOME, '~', 1)})", 6)
        return False


def _process_key(ui, key, wakes):
    if ui.confirm:
        question, fn = ui.confirm
        ui.confirm = None
        if key in ("y", "Y"):
            said = fn()
            if said:  # (one that runs in the background says so itself)
                ui.say(said)
            wakes[1].set()
        else:
            ui.say("cancelled", 2)
        return False
    if ui.prompt:
        live, text_before = ui.prompt.get("live"), ui.prompt["text"]
        if live and key in ("up", "down", "pgup", "pgdn"):  # move through the matches
            ui.move({"up": -1, "down": 1, "pgup": -10, "pgdn": 10}[key])
        elif key in ("\n", "\r"):
            prompt, ui.prompt = ui.prompt, None
            if prompt.get("live"):  # a search: Enter on an empty one clears it
                prompt["done"](prompt["text"].strip())
            elif prompt["text"].strip() or prompt.get("empty_ok"):
                message = prompt["done"](prompt["text"].strip())
                if message:  # a chained prompt returns "" and sets the next one
                    ui.say(message)
        elif key == "\033":
            ui.prompt = None
            if live:
                ui.search_edited()
        elif key in ("\x7f", "\b"):
            ui.prompt["text"] = ui.prompt["text"][:-1]
        elif key == "\x15":  # Ctrl-U
            ui.prompt["text"] = ""
        elif len(key) == 1 and key.isprintable():  # not "left", "backtab"…: those are ignored
            ui.prompt["text"] += key
        if live and ui.prompt and ui.prompt["text"] != text_before:
            ui.search_edited()
        return False
    if ui.mailbox:
        mb = ui.mailbox
        page = max(1, shutil.get_terminal_size().lines - 10)
        if key in ("j", "down"):
            ui.scroll_mail(3)
        elif key in ("k", "up"):
            ui.scroll_mail(-3)
        elif key in (" ", "pgdn"):
            ui.scroll_mail(page)
        elif key in ("b", "pgup"):
            ui.scroll_mail(-page)
        elif key == "g":
            mb["scroll"] = 0
        elif key == "G":
            mb["scroll"] = mb.get("total", 0)
        elif key == "i" and not mb["net"]:
            mb["net"], mb["scroll"] = True, 0
        elif key == "h":
            mb["html"], mb["net"], mb["scroll"] = not (mail_html(mb["id"], mb["html"]) or mb["net"]), False, 0
        elif key == "o":
            info = _mail_info.get(mb["id"]) or {}
            if info.get("source"):
                v = viewer_module()
                path = v.safe_page_path()  # 0600 in ~/.cache/mausi; images allowed there, scripts not
                with open(path, "w", encoding="utf-8") as f:
                    f.write(v.page_html(info["source"], info["cids"], network=True))
                ui.say("opening it in the browser" if cfg.open_url("file://" + path) else "couldn't open the browser", 2)
        elif key == "s":  # saved as shown; a mail shown as text is rendered first, if it has HTML
            info = _mail_info.get(mb["id"]) or {}
            if info.get("has_html") and RENDER_CMD and not (mail_html(mb["id"], mb["html"]) or mb["net"]):
                mb["html"], mb["scroll"] = True, 0
            mb["save"] = True
            ui.say("saving…", 2)
        elif key == "f":
            ui.mailbox = None
            ui.say(perform(mb["action"], "full") or "", 2)
        elif key == "d":
            mid, subject = mb["id"], mb["subject"]

            def gone():
                ui.mailbox = None
                return delete_mail_in_background(ui, wakes, mid, subject)
            ui.confirm = (f"Delete the mail (move it to the trash): {subject[:70]}?", gone)
        elif key in ("\033", "q"):
            ui.mailbox = None
        return False
    if ui.popup:
        if key in ("j", "down"):
            ui.scroll_popup(1)
        elif key in ("k", "up"):
            ui.scroll_popup(-1)
        elif key == "pgdn":
            ui.scroll_popup(15)
        elif key == "pgup":
            ui.scroll_popup(-15)
        elif key in ("\n", "\r"):
            message = perform(ui.popup[2])
            ui.popup = None
            if message:
                ui.say(message, 3)
        elif key in ("c", "C"):
            ui.say(copy_popup(ui.popup), 3)
        elif key in ("\033", " ", "q", "v", "?"):
            ui.popup = None
        return False
    key = key.lower() if key not in CASED_KEYS else key
    if ui.zoom == "mail" and ui.preview_focus:  # in the preview: scroll it; Enter, d, o… still act on the mail
        page = max(1, ui.preview_rows - 2)
        steps = {"j": 3, "down": 3, "k": -3, "up": -3, " ": page, "pgdn": page, "b": -page, "pgup": -page}
        if key in steps:
            ui.preview_scroll = max(0, ui.preview_scroll + steps[key])
            return False
        if key == "g":
            ui.preview_scroll = 0
            return False
        if key in ("\t", "backtab", "h", "left", "\033"):
            ui.preview_focus = False
            return False
    if (ui.zoom or ui.tasks) and key == "\033" and ui.search:
        ui.clear_search()
        return False
    if ui.pick and key in ("\033", "q"):
        ui.end_pick("cancelled")
        return False
    if ui.zoom == "mail" and mail_search and key == "\033":  # out of the search, still in Mail
        globals()["mail_search"] = None
        ui.selected[2] = ui.offset[2] = 0
        return False
    if ui.zoom and key in ("\033", "q", "z"):
        ui.toggle_zoom()
        return False
    if (ui.zoom or ui.tasks) and key == "/":
        ui.start_search()
        return False
    if key == "q":
        return True
    handle(ui, key, wakes)
    return False


def handle(ui, key, wakes):
    if ui.pick and key in ("\n", "\r"):
        target = ui.action() or {}
        if target.get("task") or target.get("task_id") == "unsorted":
            ui.end_pick(ui.pick["done"](target))
            wakes[1].set()
        else:
            ui.say("pick a task (or Unsorted), Esc cancels", 3)
        return
    if ui.pick and key not in ("j", "k", "down", "up", "pgdn", "pgup"):
        return  # only moving and choosing while picking
    if key == "a":
        action = ui.action() or {}
        if action.get("sid"):
            sid, what = action["sid"], f"session “{action.get('session')}”"
            cwd = (action.get("cwd") or HOME).replace(HOME, "~", 1)

            def done(target):
                title = target.get("task")
                tasks_view().link_session(sid, title)
                if not title:
                    return "session left without a task"
                # A way back to the conversation from the task, even after the session ends.
                add_to_task(task_ref(target), [f"Session: `cd {cwd} && claude --resume {sid}` ({action.get('session')})"])
                return f"session attached to “{title[:50]}”"
            ui.start_pick(what, done)
        elif attach_lines(action):
            new_lines = attach_lines(action)

            def done(target):
                if not target.get("task"):
                    return "not attached"
                return add_to_task(task_ref(target), new_lines)
            ui.start_pick(f"“{new_lines[0][:50]}…”", done)
        else:
            ui.say("a attaches a session, Slack conversation, mail, notification, PR or ticket to a task", 3)
    elif key in ("s", "f") and not (ui.action() or {}).get("shell"):
        # A shell in the task's folder (s; f is the old key). Docker and
        # Kubernetes rows have their own shell, below.
        action = ui.task_action()
        task = store().find(task_ref(action)) if action.get("task") else None
        if not task:
            ui.say("s opens a shell: in a task's folder, a container or a pod", 3)
            return
        folder = os.path.dirname(task["path"])
        subprocess.run(["kitty", "@", "launch", "--type=tab", "--tab-title", f"📁 {task['id']}", "--cwd", folder],
                       capture_output=True)
        ui.say(f"opened {folder.replace(HOME, '~', 1)}", 3)
    elif key == "y":
        # Record that the task was tried in a real use case (VERIFY -> DONE).
        action = ui.task_action()
        if not action.get("task"):
            ui.say("y (verified) works on a task", 3)
            return
        title, ref, today = action["task"], task_ref(action), time.strftime("%Y-%m-%d")
        ui.prompt = {"label": f"Verified “{title[:40]}” how? (Enter records it)", "text": "",
                     "done": lambda text: add_to_task(ref, [f"Verified {today}: {text}"])
                     + " — d marks the task done"}
    elif key == "n" and ui.tasks and ui.task_action().get("task"):
        # On a task in the task view: a note for that task, typed, or the
        # clipboard when Enter is pressed on an empty prompt; anywhere else n
        # is a quick note.
        title, ref = ui.task_action()["task"], task_ref(ui.task_action())
        stamp = time.strftime("%Y-%m-%d %H:%M")

        def save_note(text):
            if text:
                return add_to_task(ref, [f"Note {stamp}: {text}"])
            pasted = clipboard().strip()
            if not pasted:
                return "nothing typed and the clipboard is empty"
            note = [f"Note {stamp} (pasted):"] + ["  " + l for l in pasted.splitlines() if l.strip()][:40]
            preview = " ".join(pasted.split())[:60]
            ui.confirm = (f"Add the clipboard ({len(note) - 1} lines: {preview}…) to “{title[:40]}”?",
                          lambda: add_to_task(ref, note))
            return ""
        ui.prompt = {"label": f"Note for “{title[:40]}” (empty Enter = paste clipboard):", "text": "",
                     "done": save_note, "empty_ok": True}
    elif key == "v":
        ui.toggle_tasks()
    elif key == "?":
        ui.show_help()
    elif key in ("\t", "right", "l"):
        ui.switch(1)
    elif key in ("backtab", "left", "h"):
        ui.switch(-1)
    elif key in ("j", "down"):
        ui.move(1)
    elif key in ("k", "up"):
        ui.move(-1)
    elif key == "pgdn":
        ui.move(10)
    elif key == "pgup":
        ui.move(-10)
    elif key in ("\n", "\r") and MAIL_VIEWER and (ui.action() or {}).get("message_id"):
        action = ui.action()
        ui.mailbox = {"id": action["message_id"], "subject": action.get("subject", ""), "scroll": 0, "net": False,
                      "html": None,  # None: rendered if it's a designed mail, else its text; h switches
                      "from": (action.get("detail") or ("", ""))[0], "action": action}
    elif key in ("\n", "\r"):
        action = ui.action()
        if action and action.get("zoom"):
            ui.toggle_zoom()
        elif action and action.get("outside"):
            start_move_into_kitty(ui, action, wakes)
        elif action and action.get("edit") and not action.get("open") and not action.get("task"):
            edit_file(*action["edit"])  # e.g. a TODO file's item (mausi-todos)
        elif action and "copy" in action:
            ok = copy_to_clipboard(action["copy"])
            ui.say(f"copied: {action['copy_name']}" if ok else "copying to the clipboard failed")
        else:
            message = perform(action)
            if message:
                ui.say(message, 3)
    elif key == "u" and _last_done["kind"] == "triage":
        _last_done["kind"] = None
        title = context.unmark_triage_done()
        ui.say(f"back in Needs you: {title}" if title else "nothing to take back", 3)
    elif key == "u":
        ui.confirm = ("Undo the last task marked done?", undo_task_done)
    elif key in ("p", "+", "-"):
        action = ui.action()
        if action and action.get("done_task"):
            ui.say("that task is done — d reopens it", 3)
        elif action and action.get("task"):
            ref = task_ref(action)
            ui.say(toggle_task_now(ref) if key == "p" else nudge_task(ref, -1 if key == "+" else 1))
            wakes[1].set()
        else:
            ui.say(f"{key} works on a task row", 2)
    elif key == "t":
        # On a Slack conversation, mail, notification, PR or Jira row the prompt
        # starts from that item (edit it, Ctrl-U clears it); Slack, mail and
        # notifications also go into the task as context.
        action = ui.action() or {}
        seed = action.get("task_seed") or {}
        if not seed and action.get("pr") and action.get("open"):  # a PR row
            seed = {"title": action["open"], "source": "PR"}
        elif not seed and action.get("issue"):  # a Jira row
            seed = {"title": action["issue"], "source": "Jira"}

        def save_task(text):
            def run_add():  # the PR/Jira lookup can take a few seconds
                ui.say(add_task(text, seed.get("context")), 6)
                wakes[1].set()

            def add():
                threading.Thread(target=run_add, daemon=True).start()
                return "adding task…"
            have = task_for(text)
            if have:
                ui.confirm = (f"{have[0]} is already {have[1]['id']} “{have[1]['title'][:50]}” — add another task anyway?",
                              add)
                return ""
            return add()
        label = (f"New task from {seed['source']} (Enter adds, Ctrl-U clears):" if seed
                 else "New task (text, PR URL or Jira key):")
        ui.prompt = {"label": label, "text": seed.get("title", ""), "done": save_task}
    elif key == "R" and not REMINDERS_CMD:
        ui.say("no reminders: set [commands] reminders in config.toml", 3)
    elif key == "R":
        ui.prompt = {"label": "New reminder (title [@list] [due today|tomorrow|YYYY-MM-DD]):", "text": "",
                     "done": add_reminder}
    elif key == "n":
        def save_note(text):
            add_quick_note(text)
            return "noted"
        ui.prompt = {"label": "Quick note:", "text": "", "done": save_note}
    elif key == "b":
        body = clipboard()
        if not body.strip():
            ui.say("clipboard is empty — copy the text first", 3)
        else:
            def save_snippet(title):
                add_snippet(title, body)
                return f"saved snippet: {title}"
            preview = " ".join(body.split())[:40]
            ui.prompt = {"label": f"Snippet title for “{preview}…”:", "text": "", "done": save_snippet}
    elif key == "e":
        action = ui.task_action()
        task = store().find(task_ref(action)) if action.get("task") else None
        if task:
            edit_file(task["path"])  # tasks.md is generated; the task lives in its TASK.md
        elif action and action.get("edit"):
            edit_file(*action["edit"])
        else:
            ui.say("e works on a task, snippet or quick note", 2)
    elif key == "z":
        ui.toggle_zoom()
    elif key == "s":
        perform(ui.action(), "shell")
    elif key == "w":
        perform(ui.action(), "worktree")
    elif key == "d":
        action = ui.action()
        if action and action.get("triage_item"):
            context.mark_triage_done(action["triage_item"])
            _last_done["kind"] = "triage"
            ui.say("done — the next triage knows (u takes it back)", 3)
        elif action and action.get("notification"):
            dismiss(action["notification"])
            close_desktop(action.get("close"))
            ui.say("dismissed here and on the desktop (still in the log; z shows it)", 2)
        elif action and action.get("delete"):
            path, line, name = action["delete"]
            ui.confirm = (f"Delete {'snippet' if path == SNIPPETS_MD else 'note'}: {name[:70]}?",
                          lambda: delete_note(path, line, name))
        elif action and action.get("done_task"):
            tid = action["done_task"]
            ui.confirm = (f"Reopen {tid}?", lambda: reopen_task(tid))
        elif action and action.get("task"):
            title, ref = action["task"], task_ref(action)
            ui.confirm = (f"Mark done and move to Done: {title[:80]}?", lambda: mark_task_done(ref))
        elif action and action.get("reminder"):
            rid, title = action["reminder"], action["reminder_title"]
            ui.confirm = (f"Mark the reminder done: {title[:80]}?", lambda: complete_reminder(rid, title))
        elif action and action.get("message_id") and MAIL_VIEWER:
            mid, subject = action["message_id"], action.get("subject", "")
            ui.confirm = (f"Delete the mail (move it to the trash): {subject[:70]}?", lambda: delete_mail_in_background(ui, wakes, mid, subject))
        else:
            ui.say("d works on a Needs-you item, task, reminder, mail, notification, snippet or quick note", 2)
    elif key == "D":
        ui.confirm = ("Dismiss all notifications up to now (and close them on the desktop)?",
                      lambda: (dismiss(), close_desktop(recent_notification_ids()), "all dismissed")[-1])
    elif key == "L" and not ENERGY_LOG:
        ui.say("no energy log: set [energy] log in config.toml", 3)
    elif key == "L":
        def ask_valence(activity, state):
            def done(answer):
                valence = VALENCES.get(answer.split()[0].lower().replace("-energy", ""))
                if not valence:
                    return f"not logged — valence must be one of: {', '.join(VALENCES)}"
                log_energy(activity, state, valence)
                return f"logged: {activity} · {state} · {valence}"
            ui.prompt = {"label": "Valence (gave / neutral / took):", "text": "", "done": done}
            return ""

        def ask_state(activity):
            def done(answer):
                state = next((x for x in STATES if x.startswith(answer.lower())), None)
                if not state:
                    return f"not logged — state must be one of: {', '.join(STATES)}"
                return ask_valence(activity, state)
            ui.prompt = {"label": f"State ({' / '.join(STATES)}):", "text": "", "done": done}
            return ""
        ui.prompt = {"label": "Log energy — what were you doing?", "text": "", "done": ask_state}
    elif key == "c":
        action = ui.action()
        if action and action.get("detail"):
            perform(action, "chat")
            ui.say("opened a Claude session in a new tab")
        else:
            ui.say("c works on a task, ticket, PR or notification", 2)
    elif key in (" ", "v"):
        ui.open_popup()
    elif key == "r":
        store().sync()
        ctx.refresh(hard=True)
        wakes[3].set()
        ui.say("refreshing — Jira and GitHub fresh from the board", 3)
    elif key == "i":
        ctx.refresh("triage", hard=True)
        ui.say("asking Claude what needs you (a few seconds)…", 5)
    elif key == "m":
        url = next_meet()
        if url:
            ui.say(perform({"open": url}), 3)
    elif key == "o":
        action = ui.action() or {}
        if action.get("message_id") and MAIL_OPEN_CMD:
            # On a mail: the configured mail_open command, e.g. thunderbird mid:{id}.
            subprocess.Popen([a.replace("{id}", action["message_id"]) for a in shlex.split(MAIL_OPEN_CMD)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            ui.say("opening the mail", 2)
        else:
            if BOARD_URL:
                ui.say(perform({"open": BOARD_URL}), 3)
    elif key == "g":
        subprocess.run(["kitty", "@", "kitten", PICKER],
                       capture_output=True)
    elif key.isdigit():
        n = int(key) or 10
        subprocess.run(["kitty", "@", "action", "goto_tab", str(n)],
                       capture_output=True)


if __name__ == "__main__":
    if sys.argv[1:] == ["--check"]:  # the restart's trial run: everything loaded, nothing started
        store()
        sys.exit(0)
    main()
