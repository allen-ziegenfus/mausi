NON_HTTP_PORTS = {"5432", "3306", "6379", "27017", "9200", "11311"}


def host_port(ports):
    # "0.0.0.0:8080->8080/tcp, [::]:8080->8080/tcp" -> "8080" (first web one)
    for host, container in re.findall(r"(?:0\.0\.0\.0|\[::\]|127\.0\.0\.1):(\d+)->(\d+)", ports or ""):
        if container not in NON_HTTP_PORTS:
            return host
    return None


