PR_URL_RE = re.compile(r"https://github\.com/([^/\s]+)/([^/\s]+)/pull/(\d+)\S*")
PR_SHORT_RE = re.compile(r"(?<![\w./-])([A-Za-z0-9][\w.-]*)/([\w.-]+)#(\d+)\b")  # owner/repo#N
NEW_TASK_SECTION = "### Follow-ups"
