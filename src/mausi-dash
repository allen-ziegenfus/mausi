def why_tag(pr):
    """Why an Involved PR is listed: review requests first, then my tickets
    (preferring one the PR only references over its own title's)."""
    why = pr.get("why") or []
    keys = sorted((w for w in why if TICKET_RE.match(w)), key=lambda k: k in pr["title"])
    if "your repo" in why:
        return f"{DIM}in your repo · {pr.get('author') or '?'}{RESET}"
    if "review requested" in why:
        return f"{YELLOW}review requested{RESET}"
    if keys:
        return f"{CYAN}your ticket {keys[0]}{RESET}" + (f"{DIM} +{len(keys) - 1}{RESET}" if len(keys) > 1 else "")
    return f"{DIM}involves you{RESET}"


def nest_tickets(tickets):
    """[(ticket, depth)]: sub-tasks right under their parent when the parent is
    in the list too, otherwise where they were; order kept otherwise."""
    keys = {i["key"] for i in tickets}
    children = {}
    for i in tickets:
        if i.get("parent") in keys:
            children.setdefault(i["parent"], []).append(i)
    out = []

    def add(i, depth):
        out.append((i, depth))
        for c in children.get(i["key"], []):
            add(c, depth + 1)
    for i in tickets:
        if i.get("parent") not in keys:
            add(i, 0)
    return out


def ticket_label(key, depth, width=13):
    """The key column: a sub-task indented under its parent with └."""
    return (("  " * (depth - 1) + "└ ") if depth else "") + key + " " * max(0, width - len(key) - 2 * depth)


