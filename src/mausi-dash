TAB_MARKS = ("⏳", "▶", "▷")
_mark_pending = {}  # window id -> the mark a scan found missing; set when the next scan agrees


def sync_tab_marks(rows):
    """Put each Claude tab's title mark right where no hook can: ▷ while an
    idle session has background jobs (no hook fires when they end), and no ▶
    once a turn ended without Stop (Esc). ⏳ and a live ▶ are the hooks'.
    A mismatch is fixed only when two scans in a row see it, so a hook that
    is changing the tab at that moment wins."""
    mark_cmd = os.path.join(os.path.dirname(os.path.realpath(__file__)), "mausi-mark")
    seen = set()
    for r in rows:
        if not r.get("window_id"):
            continue
        seen.add(r["window_id"])
        want = "⏳" if r["wait"] else "▶" if r["busy"] else "▷" if r["bg"] else ""
        have = next((m for m in TAB_MARKS if r["tab_title"].startswith(m + " ")), "")
        if want == have or want in ("⏳", "▶"):
            _mark_pending.pop(r["window_id"], None)
            continue
        if _mark_pending.get(r["window_id"]) != want:
            _mark_pending[r["window_id"]] = want
            continue
        _mark_pending.pop(r["window_id"], None)
        env = dict(os.environ, KITTY_WINDOW_ID=str(r["window_id"]))
        subprocess.Popen([mark_cmd, "bg" if want == "▷" else "idle"], env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for gone in set(_mark_pending) - seen:
        _mark_pending.pop(gone, None)


