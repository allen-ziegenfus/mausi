def task_for(text):
    """(key or PR, open task) when a Jira key or PR in text already has a task:
    the key in the task's title or summary, or the PR URL anywhere in it."""
    keys = [k for k in TICKET_ANY_RE.findall(text) if not store().ID_RE.fullmatch(k)]
    # A PR as owner/repo#N, whether the text has its URL or that short form.
    prs = {f"{m[1]}/{m[2]}#{m[3]}": m.group(0) for m in PR_URL_RE.finditer(text)}
    for m in PR_SHORT_RE.finditer(text):
        prs.setdefault(m.group(0), f"https://github.com/{m[1]}/{m[2]}/pull/{m[3]}")
    if not keys and not prs:
        return None
    for t in store().load_all():
        if t.get("status") != "open":
            continue
        head = f"{t['title']} {t.get('summary', '')}"
        body = head + "\n" + "\n".join(t.get("notes", []))
        for k in keys:
            if re.search(rf"\b{re.escape(k)}\b", head):
                return k, t
        for short, url in prs.items():
            m = PR_SHORT_RE.match(short)
            if (re.search(rf"github\.com/{re.escape(m[1])}/{re.escape(m[2])}/pull/{m[3]}\b", body)
                    or re.search(rf"(?<![\w.-]){re.escape(short)}\b", body)):
                return url, t
    return None


def move_into_kitty(action, task_title=""):
    """Enter on a session running outside kitty: quit it there (SIGTERM), wait
    for it to exit, then resume it in a new kitty tab. Never resumes while the
    old process lives: two processes on one session corrupt its transcript."""
    out, sid, cwd = action["outside"], action["sid"], action["cwd"]
    pid = out["pid"]
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        pass
    except PermissionError:
        return f"can't quit pid {pid} in {out['where']}: not yours"
    for _ in range(50):  # up to 10 s
        if not snapshots.alive(pid):
            break
        time.sleep(0.2)
    else:
        return f"it didn't quit in {out['where']} (pid {pid}); quit it there, then run mausi"
    title = os.path.basename(cwd) or "claude"
    q = shlex.quote(sid)
    shell = os.environ.get("SHELL", "/bin/zsh")
    cmd = (f"claude --resume {q}; rc=$?; if [ $rc -ne 0 ]; then "
           f"printf '\\n[mausi] claude --resume %s exited %s — leaving a shell here\\n' {q} \"$rc\"; "
           f"exec {shlex.quote(shell)} -l; fi")
    task_var = ["--var", f"claude_task={task_title}"] if task_title else []
    r = subprocess.run(["kitty", "@", "launch", "--type=tab", "--cwd", cwd, "--tab-title", f"💬 {title}",
                        "--var", f"claude_session={sid}", "--var", f"claude_title={title}", *task_var,
                        shell, "-lc", cmd], capture_output=True)
    return f"moved “{title}” into kitty" if r.returncode == 0 else f"kitty launch failed: {r.stderr.decode()[:80]}"


def start_move_into_kitty(ui, action, wakes):
    """Ask, offer a task for it, then move it (in the background: the quit can
    take a few seconds)."""
    out = action["outside"]
    busy = " It's active right now: a reply in progress is cut off." if out.get("age") == "now" else ""

    def run(task_title):
        def bg():
            ui.say(move_into_kitty(action, task_title), 6)
            wakes[1].set()
        threading.Thread(target=bg, daemon=True).start()

    def with_task(text):
        title = ""
        if text:
            cwd = action["cwd"].replace(HOME, "~", 1)
            line = f"Session: `cd {cwd} && claude --resume {action['sid']}` ({action.get('session')})"
            tid = store().create(text, section=NEW_TASK_SECTION[4:], notes=[line])
            tasks_view().link_session(action["sid"], text)
            title = text
            ui.say(f"added {tid}; moving the session…", 6)
        run(title)
        return "" if text else "moving the session…"

    def ask_task():
        if tasks_view() and tasks_view().session_task_title(action["sid"]):
            run("")  # already attached to a task
            return "moving the session…"
        ui.prompt = {"label": "New task for it? (Enter creates, empty Enter skips, Esc cancels the move):",
                     "text": os.path.basename(action["cwd"]), "done": with_task, "empty_ok": True}
        return ""
    ui.confirm = (f"Quit this session in {out['where']} and resume it in a kitty tab?{busy}", ask_task)


def add_task(text, context=None):
    """t: a new task at the top of Follow-ups. context: notes for it, e.g. the
    Slack message it came from."""
    entry, head = new_task_entry(text)
    m = re.match(r"- \[ \] \*\*(.+?)\*\*\s*(.*)", entry[0])
    title, summary = (m.group(1), m.group(2)) if m else (head, "")
    notes = [f"- {c}" for c in context or []] + [l[2:] for l in entry[1:]]
    tid = store().create(title, summary, section=NEW_TASK_SECTION[4:], notes=notes)
    return f"added {tid} to {NEW_TASK_SECTION[4:]}: {head[:60]}"


