def mausi_version():
    """What's running: "mausi <VERSION> (<commit>[+] <its date>)", "+" when
    the checkout has changes not committed; without git just the version. Read
    at start, so after a restart it's the new one."""
    here = os.path.dirname(os.path.realpath(__file__))
    try:
        with open(os.path.join(os.path.dirname(here), "VERSION")) as f:
            semver = f.read().strip()
    except OSError:
        semver = ""
    name = f"mausi {semver}".strip()
    try:
        r = subprocess.run(["git", "-C", here, "--no-optional-locks", "log", "-1", "--format=%h %cd",
                            "--date=format:%Y-%m-%d %H:%M"], capture_output=True, text=True, timeout=5)
        dirty = subprocess.run(["git", "-C", here, "--no-optional-locks", "status", "--porcelain", "--untracked-files=no"],
                               capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return name if semver else ""
    if r.returncode != 0 or not r.stdout.strip():
        return name if semver else ""
    commit, _, date = r.stdout.strip().partition(" ")
    return f"{name} ({commit}{'+' if dirty else ''} {date})"


