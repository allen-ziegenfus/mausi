class Ui:
    def __init__(self, view=0):
        # The focused view: the column with the cursor when side by side, the
        # view shown when the window is too narrow for both.
        self.view = view if isinstance(view, int) else 0
        # Per view: index of the selected row among the actionable ones, and
        # the first body line shown.
        # Index 2 is the zoomed section's full-screen view; 3 and 4 are the
        # task view's list and the selected task's details.
        self.selected = [0, 0, 0, 0, 0]
        self.offset = [0, 0, 0, 0, 0]
        self.lines = [[], [], [], [], []]
        self.tasks = view == "tasks"  # the task view (v) instead of Now | Work
        self.tview = 3  # its focused column
        self.task_title = None  # the selected task, kept selected when the list reorders
        self.pick = None  # a: {"what", "done": fn(task action) -> message, "back": (tasks, tview, zoom)} while picking a task
        self.popup = None  # [title, text, action] while the detail box is open
        self.mailbox = None  # {"id", "subject", "from", "scroll", "net", "total"} while a mail is open
        self.popup_scroll = 0
        self.zoom = None   # section name while zoomed in (z)
        self.preview_focus = False  # zoomed Mail: Tab moved into the preview below the list (j/k scroll it)
        self.preview_scroll = 0     # its scroll, in terminal rows; back to 0 on another mail
        self.preview_id = None      # the mail it was scrolled on
        self.preview_rows = 10      # how tall it was last drawn (a page for space/b)
        self.searches = {}  # each list's filter (/), see search
        self.retop = False  # the search changed: select its first match
        self.keep = None   # Esc cleared the search: the zoomed entry to stay on
        self.split = 0     # last screen column of the left view when side by side, else 0
        self.flash = None  # (message, until) shown in the key line
        self.prompt = None  # {"label", "text", "done": fn(text)} — a one-line input
        self.confirm = None  # (question, fn) — y runs fn, anything else cancels

    def say(self, message, secs=4):
        self.flash = (message, time.time() + secs)

    def selected_line(self, v=None):
        v = self.view if v is None else v
        rows = [i for i, (_, action) in enumerate(self.lines[v]) if action]
        if not rows:
            return None
        self.selected[v] = max(0, min(self.selected[v], len(rows) - 1))
        return rows[self.selected[v]]

    def current(self):
        return 2 if self.zoom else self.tview if self.tasks else self.view

    def move(self, delta):
        v = self.current()
        self.selected[v] += delta
        self.selected_line(v)

    def wheel(self, delta, column):
        """Mouse wheel: move the cursor in the column under the pointer."""
        if not self.zoom and self.split:
            if self.tasks:
                self.tview = 3 if column <= self.split else 4
            else:
                self.view = 0 if column <= self.split else 1
        self.move(delta)

    def switch(self, delta=1):
        if self.zoom == "mail" and MAIL_VIEWER and delta > 0:
            self.preview_focus = True  # into the preview (Tab/h/Esc: back to the list)
        if self.zoom:
            return
        if self.tasks:
            self.tview = 4 if self.tview == 3 else 3
        else:
            self.view = (self.view + delta) % len(VIEWS)

    def start_pick(self, what, done):
        """a: show the task list to choose where the item goes."""
        self.pick = {"what": what, "done": done, "back": (self.tasks, self.tview, self.zoom)}
        self.tasks, self.tview, self.zoom = True, 3, None
        self.search = ""

    def search_key(self):
        return f"zoom:{self.zoom}" if self.zoom else "pick" if self.pick else "tasks" if self.tasks else ""

    @property
    def search(self):
        """The filter (/) of the list on screen. Each zoomed section, the task
        list and the a picker have their own, so one never shows up in another;
        each starts empty when it is opened."""
        return self.searches.get(self.search_key(), "")

    @search.setter
    def search(self, text):
        self.searches[self.search_key()] = text

    def end_pick(self, message=None):
        self.tasks, self.tview, self.zoom = self.pick["back"]  # back where a was pressed
        self.pick = None
        if message:
            self.say(message, 5)

    def toggle_tasks(self):
        if not self.zoom:
            self.tasks = not self.tasks
            self.search = ""  # the view just opened starts unfiltered

    def action(self):
        v = self.current()
        line = self.selected_line(v)
        return self.lines[v][line][1] if line is not None else None

    def task_action(self):
        """The selected row if it is a task; in the task view's details column
        (its files, tickets…) the task selected in the list."""
        action = self.action() or {}
        if not action.get("task") and self.tasks and not self.zoom:
            line = self.selected_line(3)
            action = (self.lines[3][line][1] if line is not None else None) or {}
        return action

    def toggle_zoom(self):
        self.preview_focus = False
        if self.zoom:
            self.zoom = None
            return
        action = self.action()
        if action and action.get("section"):
            self.zoom = action["section"]
            self.search = ""
            self.selected[2] = self.offset[2] = 0

    def query(self):
        """The filter of the zoomed view or the task list: the search being typed,
        else the last one."""
        if self.prompt and self.prompt.get("live"):
            return self.prompt["text"]
        return self.search

    def start_search(self):
        v = 2 if self.zoom else 3
        if v == 3:
            self.tview = 3

        mail_zoom = self.zoom == "mail" and MAIL_CMD

        def done(text):  # Enter keeps the filter and the match ↑↓ chose
            if mail_zoom and text:  # in Mail, Enter also searches every folder on the server
                start_mail_search(text)
                self.search = ""
                self.selected[2] = self.offset[2] = 0
                return f"searching every folder for “{text}”…"
            self.search = text
            return ""
        self.prompt = {"label": "/ (Enter: search every folder)" if mail_zoom else "/", "text": self.search,
                       "done": done, "live": True}

    def search_edited(self):
        """The search text changed: start again at the first match."""
        v = 2 if self.zoom else 3
        self.selected[v] = self.offset[v] = 0
        self.retop = True

    def clear_search(self):
        """Esc: drop the filter but stay on the selected entry (the task list
        keeps its selected task by itself)."""
        self.keep = self.action() if self.zoom else None
        self.search = ""

    def open_popup(self):
        action = self.action()
        if action and action.get("file"):  # a task's file: its text
            self.popup = [action["file"].replace(HOME, "~", 1), file_text(action["file"])[0], action]
            self.popup_scroll = 0
        elif action and action.get("detail"):
            title, text = action["detail"]
            self.popup = [title, text, action]
            self.popup_scroll = 0
            if action.get("issue"):
                fetch_issue_async(action["issue"], force=True)
            elif action.get("pr"):
                fetch_detail_async(pr_path(action["pr"]), force=True)

    def show_help(self):
        self.popup = ["Keys", HELP, {}]
        self.popup_scroll = 0

    def scroll_popup(self, delta):
        self.popup_scroll = max(0, self.popup_scroll + delta)

    def mailbox_lines(self, width, height):
        """The open mail: a box over the dashboard, the rendered mail in it."""
        mb = self.mailbox
        box_w, box_h = max(30, width - 6), max(8, height - 4)
        row, col = 3, (width - box_w) // 2  # 1-based row of the top border, 0-based column
        inner_w, inner_h = box_w - 4, box_h - 4
        title = clip(f"{BOLD}{mb['subject']}{RESET}{CYAN}", box_w - 8)
        keys = ("j/k ↑↓ space scroll · d delete · s save · " + ("" if mb["net"] or not RENDER_CMD else "i images · ")
                + "o browser · f full screen · q close")
        out = [f"\033[{row};{col + 1}H{CYAN}╭─ {title} " + "─" * max(0, box_w - 5 - visible_len(title)) + f"╮{RESET}",
               f"\033[{row + 1};{col + 1}H{CYAN}│{RESET} {fit(DIM + mb['from'] + RESET, inner_w)} {CYAN}│{RESET}"]
        for r in range(row + 2, row + box_h - 1):
            out.append(f"\033[{r};{col + 1}H{CYAN}│{RESET}{' ' * (box_w - 2)}{CYAN}│{RESET}")
        html = mail_html(mb["id"], mb["html"])
        kind, what = mail_view(mb["id"], html, mb["net"])
        if kind == "busy" and mb["net"]:  # the plain rendering while the images load
            kind, what = mail_view(mb["id"], True)
        info = _mail_info.get(mb["id"]) or {}
        if info and not mb.get("save") and (kind == "busy" or kind == "failed" and mb["html"] is None):
            kind, what = "text", info["text"]  # its text while it renders (or if it can't); s waits for it
        if info.get("has_html") and RENDER_CMD:
            keys = ("h text · " if html or mb["net"] else "h rendered · ") + keys
        if mb.get("save") and kind in ("text", "png", "failed") and not (mb["net"] and _preview["busy"]):
            # s asked for it; now it's there (with images: once they've loaded)
            mb["save"] = False
            self.say(save_mail(mb, kind, what), 4)
        seq = ""
        if kind == "text":
            lines = wrap_text(what, min(inner_w, 110))
            mb["total"] = len(lines)
            mb["scroll"] = max(0, min(mb["scroll"], mb["total"] - inner_h))
            left = col + 2 + max(0, (inner_w - min(inner_w, 110)) // 2)
            seq = "".join(f"\033[{row + 2 + i};{left + 1}H{l}"
                          for i, l in enumerate(lines[mb["scroll"]:mb["scroll"] + inner_h]))
        elif kind == "png":
            seq, mb["total"] = place_png(what, row + 2, col + 2, inner_h, inner_w, mb["scroll"])
            mb["scroll"] = max(0, min(mb["scroll"], mb["total"] - inner_h))
        else:
            seq = f"\033[{row + 3};{col + 4}H{DIM}{'no preview — o opens it in the browser' if kind == 'failed' else 'loading…'}{RESET}"
        if kind in ("text", "png"):
            pct = 100 if mb["total"] <= inner_h else int(100 * (mb["scroll"] + inner_h) / mb["total"])
            keys += f" · {min(pct, 100)}%"
        if mb["net"] and _preview["busy"]:
            keys += " · loading images…"
        out.append(f"\033[{row + box_h - 1};{col + 1}H{CYAN}╰─{RESET} {DIM}{clip(keys, box_w - 8)}{RESET} {CYAN}"
                   + "─" * max(0, box_w - 5 - visible_len(clip(keys, box_w - 8))) + f"╯{RESET}")
        return "".join(out) + seq

    def scroll_mail(self, step):
        mb = self.mailbox
        mb["scroll"] = max(0, min(mb["scroll"] + step, max(0, mb.get("total", 0) - 1)))

    def popup_box(self, width, height):
        """The detail box as (row, col, lines) to draw over the body."""
        title, text, action = self.popup
        if action.get("issue"):
            text = issue_text(action["issue"], action["detail"][1])
        elif action.get("pr"):
            text = pr_text(action["pr"], action["detail"][1])
        box_width = max(24, min(width - 4, 110))  # a very narrow window gets a clipped box, not a crash
        inner = box_width - 4
        wrapped = []
        for para in text.split("\n"):
            indent = len(para) - len(para.lstrip(" "))
            wrapped += textwrap.wrap(para, inner, subsequent_indent=" " * min(indent + 2, 12, inner // 2)) or [""]
        room = max(1, height - 8)
        self.popup_scroll = min(self.popup_scroll, max(0, len(wrapped) - room))
        rows = wrapped[self.popup_scroll:self.popup_scroll + room]
        scrolls = len(wrapped) > room
        footer = (("Enter open · " if action.get("open") else "") + ("j/k ↑↓ scroll · " if scrolls else "")
                  + ("c copy TASK.md · " if action.get("task") else "c copy file · " if action.get("file")
                     else "c copy · " if action else "") + "Esc/Space close")
        if scrolls:
            footer += f" · {self.popup_scroll + len(rows)}/{len(wrapped)}"
        top = f"{CYAN}╭─ {BOLD}{clip(title, box_width - 6)}{RESET}{CYAN} " 
        top += "─" * max(0, box_width - 4 - visible_len(clip(title, box_width - 6))) + f"╮{RESET}"
        lines = [top]
        lines += [f"{CYAN}│{RESET} {fit(r, inner)} {CYAN}│{RESET}" for r in rows]
        lines.append(f"{CYAN}│{RESET} {fit('', inner)} {CYAN}│{RESET}")
        lines.append(f"{CYAN}╰─{RESET} {DIM}{footer}{RESET} {CYAN}"
                     + "─" * max(0, box_width - 5 - visible_len(footer)) + f"╯{RESET}")
        return max(3, (height - len(lines)) // 3), max(0, (width - box_width) // 2), lines

    def draw_tasks_lines(self, rows, width):
        """Fill the task list (3) and the selected task's details (4), keeping
        the same task selected when the list reorders. A task is followed by its
        AZ id: titles can repeat, and a repeated one would pull the cursor back."""
        def ident(a):
            return a.get("tid") or a.get("task") or a.get("task_id")
        old = None if self.retop else self.selected_line(3)
        self.retop = False
        if old is not None and self.lines[3][old][1]:
            self.task_title = ident(self.lines[3][old][1])
        self.lines[3] = search_lines(task_view_lines("list_lines", rows), self.query(), deep=True)
        actionable = [a for _, a in self.lines[3] if a]
        for n, a in enumerate(actionable):
            if self.task_title == ident(a):
                self.selected[3] = n
                break
        line = self.selected_line(3)
        task_id = self.lines[3][line][1].get("task_id") if line is not None else None
        if tasks_view() is not None:
            tasks_view().note_selected(self.lines[3][line][1].get("task") if line is not None else None)
        if task_id != getattr(self, "_detail_for", None):
            self._detail_for = task_id
            self.selected[4] = self.offset[4] = 0
        self.lines[4] = task_view_lines("detail_lines", rows, task_id, width - 2)

    def column(self, v, width, height, focused):
        """Render view v as exactly height lines of exactly width cells."""
        lines = self.lines[v]
        selected = self.selected_line(v)
        if selected is not None:
            if selected < self.offset[v]:
                self.offset[v] = selected
            elif selected >= self.offset[v] + height:
                self.offset[v] = selected - height + 1
        self.offset[v] = max(0, min(self.offset[v], max(0, len(lines) - height)))
        # The last line turns into "… more below" when there is more, so the
        # selected line must not sit there.
        if selected is not None and selected == self.offset[v] + height - 1 and len(lines) > selected + 1:
            self.offset[v] += 1

        out = []
        for i, (text, _) in enumerate(lines[self.offset[v]:self.offset[v] + height], self.offset[v]):
            if i == selected and focused:
                out.append(fit(f"{CYAN}▸{RESET}\033[7m{text}", width))
            elif i == selected:
                out.append(fit(f"{DIM}›{RESET}{text}", width))
            else:
                out.append(fit(f" {text}", width))
        more = len(lines) - (self.offset[v] + height)
        if more > 0 and out:
            out[-1] = fit(f" {DIM}… {more} more below{RESET}", width)
        return out + [" " * width] * (height - len(out))

    def prepare(self, rows, width):
        """Fill the lines of what is on screen for a window this wide; returns
        whether two columns fit side by side."""
        two = width >= TWO_COLUMN_WIDTH and not self.zoom
        if self.zoom:
            # A search in Notifications looks through the whole capture log.
            history = self.zoom == "notifications" and bool(self.query())
            self.lines[2] = search_lines(section_lines(self.zoom, rows, True, width - 2, history), self.query())
            if self.keep is not None:
                actionable = [a for _, a in self.lines[2] if a]
                if self.keep in actionable:
                    self.selected[2] = actionable.index(self.keep)
                self.keep = None
        elif self.tasks:
            self.draw_tasks_lines(rows, width if not two else (width - 3) // 2)
        else:
            self.lines[:2] = [view_lines(name, rows) for name in VIEWS]
        return two

    def status(self, two):
        """The header's view tabs and its key line (or the flashed message)."""
        if self.pick:
            tabs = f"{BOLD}{YELLOW}Attach {self.pick['what'][:60]} to which task?{RESET}"
            keys = "? keys · ↑↓/jk choose a task · / search · Enter attach · Enter on Unsorted = no task · Esc cancel"
        elif self.tasks and not self.zoom:
            tabs = f"{BOLD}{CYAN}[Tasks]{RESET} {DIM}v system view{RESET}"
            keys = ("? keys · " + ("Tab/←→ column" if two else "Tab list/details")
                    + " · / search · ↑↓/jk move · Enter open · Space details · c chat · w worktree · d done · p pin · e edit"
                    " · t new task · a attach to a task · n note to task (empty Enter pastes) · y verified · s shell in the task folder · v system view · r refresh · q quit")
        elif self.zoom:
            tabs = f"{BOLD}{CYAN}[{SECTION_TITLES[self.zoom]}]{RESET} {DIM}full screen{RESET}"
            if self.query():
                matches = sum(1 for _, action in self.lines[2] if action)
                tabs += f"  {YELLOW}/{self.query()}{RESET} {DIM}({matches} match{'' if matches == 1 else 'es'}){RESET}"
            keys = ("? keys · z/Esc/q back · / search · ↑↓/jk move · Enter open/copy · Space details · d done · u undo · p pin · +/- move"
                    " · c chat · t new task · a attach · o open mail · n note · b snippet · e edit · s shell · w worktree · r refresh")
        else:
            tabs = "  ".join(f"{BOLD}{CYAN}[{name}]{RESET}" if i == self.view else f"{DIM}{name}{RESET}"
                             for i, name in enumerate(VIEWS)) + f"  {DIM}v tasks{RESET}" + (
                                 f"  {DIM}· {VERSION}{RESET}" if VERSION else "")
            keys = "? keys · " + ("Tab/←→ column" if two else "Tab view") + (
                " · ↑↓/jk move · Enter open/copy · z zoom · Space details · d done · u undo · p pin · +/- move"
                " · L log energy · D dismiss all · c chat with Claude · t new task · a attach to a task · o open mail · n note · b snippet from clipboard · e edit · s shell · w worktree"
                " · 1-9/0 tab · g picker · m meet · o web board (on a mail: open it) · r refresh · q quit")
        if self.tasks and not self.zoom and self.query():
            matches = sum(1 for _, action in self.lines[3] if action)
            tabs += f"  {YELLOW}/{self.query()}{RESET} {DIM}({matches} match{'' if matches == 1 else 'es'} · Esc clears){RESET}"
        if self.flash and time.time() < self.flash[1]:
            keyline = f"{YELLOW}{self.flash[0]}{RESET}"
        elif _deleting:
            subjects = list(_deleting.values())
            more = f" (+{len(subjects) - 1} more)" if len(subjects) > 1 else ""
            keyline = f"{YELLOW}⏳ deleting: {subjects[0][:60]}{more}…{RESET}"
        else:
            keyline = f"{DIM}{keys}{RESET}"
        return tabs, keyline

    def draw(self, rows):
        width, height = shutil.get_terminal_size()
        self.split = 0
        two = self.prepare(rows, width)
        tabs, keyline = self.status(two)
        header = [
            clip(f"{BOLD}mausi{RESET} {DIM}{time.strftime('%H:%M:%S')}{RESET}  {tabs}", width),
            clip(keyline, width),
            "",
        ]
        body_height = max(1, height - len(header) - 1)

        preview = ""
        if self.zoom == "mail" and MAIL_VIEWER and body_height >= 12:
            # The list on top, the selected mail below (Enter: in a box).
            list_height = body_height // 2
            rows = body_height - list_height - 1
            body = self.column(2, width, list_height, True)
            mid = (self.action() or {}).get("message_id")
            if mid != self.preview_id:
                self.preview_id, self.preview_scroll = mid, 0
            total = 0
            if mid:
                preview, total = mail_preview(mid, len(header) + list_height + 2, rows, width, self.preview_scroll)
            self.preview_rows = rows
            self.preview_scroll = max(0, min(self.preview_scroll, total - rows))
            if self.preview_focus:
                pct = 100 if total <= rows else min(100, int(100 * (self.preview_scroll + rows) / total))
                label = f" j/k ↑↓ space b scroll · Tab back to the list · {pct}% "
                body.append(f"{CYAN}──{clip(label, width - 4)}" + "─" * max(0, width - 2 - len(label)) + RESET)
            else:
                label = " Tab: into the preview " if mid and total > rows else ""
                body.append(f"{DIM}──{label}" + "─" * max(0, width - 2 - len(label)) + RESET)
            body += [""] * rows
        elif self.zoom:
            body = self.column(2, width, body_height, True)
        elif self.tasks and two:
            left_width = (width - 3) // 2
            right_width = width - 3 - left_width
            self.split = left_width + 1
            left = self.column(3, left_width, body_height, self.tview == 3)
            right = self.column(4, right_width, body_height, self.tview == 4)
            body = [f"{l}{DIM} │ {RESET}{r}" for l, r in zip(left, right)]
        elif self.tasks:
            body = self.column(self.tview, width, body_height, True)
        elif two:
            left_width = (width - 3) // 2
            right_width = width - 3 - left_width
            self.split = left_width + 1
            left = self.column(0, left_width, body_height, self.view == 0)
            right = self.column(1, right_width, body_height, self.view == 1)
            body = [f"{l}{DIM} │ {RESET}{r}" for l, r in zip(left, right)]
        else:
            body = self.column(self.view, width, body_height, True)

        overlay = ""
        if self.mailbox:
            overlay = self.mailbox_lines(width, height)
        elif self.popup:
            row, col, box = self.popup_box(width, height)
            overlay = "".join(f"\033[{row + i + 1};{col + 1}H{line}" for i, line in enumerate(box))
        if self.prompt or self.confirm:
            ask = (f"{self.prompt['label']} {self.prompt['text']}█" if self.prompt
                   else f"{self.confirm[0]} [y/N]")
            overlay += f"\033[{height};1H\033[7m{fit(' ' + ask, width)}\033[0m"
        # (ESC[2J also frees the open mail's image: the overlay sends it again)
        sys.stdout.write("\033[H\033[2J" + "\n".join(header + body) + preview + overlay)
        sys.stdout.flush()


_launched = {}  # folder -> when Enter on Projects started Claude there
LAUNCH_GRACE = 15  # seconds


# --- the open mail (Enter on a mail: a box over the dashboard) ------------------
PREVIEW_DIR = os.path.join(cfg.CACHE_DIR, "mail-png")  # rendered mails, newest PREVIEW_KEEP kept
PREVIEW_KEEP = 40
PREVIEW_IMAGE = 4712  # kitty image id
_preview = {"busy": None, "failed": {}}  # failed: key -> when (tried again after PREVIEW_RETRY)
PREVIEW_RETRY = 60
_viewer = {}


def viewer_module():
    """bin/mausi-mail-view as a module: its rendering, here in the background."""
    if "m" not in _viewer:
        import importlib.machinery
        import importlib.util
        path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "bin", "mausi-mail-view")
        loader = importlib.machinery.SourceFileLoader("mausi_mail_view", path)
        spec = importlib.util.spec_from_loader("mausi_mail_view", loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        _viewer["m"] = module
    return _viewer["m"]


_mail_info = {}  # message id -> {"text": its text, "has_html": bool, "designed": bool, "source", "cids"}


def mail_html(message_id, asked=None):
    """Whether to show the mail rendered: as asked (h), else when it's a
    designed mail (lots of images or tables; see plain_enough)."""
    if asked is not None:
        return asked
    return bool((_mail_info.get(message_id) or {}).get("designed")) and bool(RENDER_CMD)


def mail_view(message_id, html=False, network=False):
    """How to show the mail: ("text", str) unless html (or network) is asked
    for and it has HTML; ("png", (path, w, h)) rendered; ("busy", None) while
    it's fetched or rendered (in a thread; one at a time); ("failed", None).
    network: rendered with its remote images."""
    import hashlib
    info = _mail_info.get(message_id)
    key = message_id + (" +net" if network else "")
    if info is not None and (not (html or network) or not info["has_html"] or not RENDER_CMD):
        return "text", info["text"]
    path = os.path.join(PREVIEW_DIR, hashlib.sha1(key.encode()).hexdigest() + ".png")
    if info is not None and os.path.exists(path):
        with open(path, "rb") as f:
            w, h = __import__("struct").unpack(">II", f.read(24)[16:24])
        return "png", (path, w, h)
    if time.time() - _preview["failed"].get(key, 0) < PREVIEW_RETRY:
        return "failed", None
    if not _preview["busy"]:
        _preview["busy"] = key
        threading.Thread(target=_mail_worker, args=(message_id, path, html or network, network),
                         daemon=True).start()
    return "busy", None


def _mail_worker(message_id, path, render, network):
    """Fetch the mail (once) and, if render, render it."""
    import email
    import email.policy
    import html as _html
    import tempfile
    key = message_id + (" +net" if network else "")
    try:
        v = viewer_module()
        info = _mail_info.get(message_id)
        if info is None:
            r = subprocess.run(MAIL_CMD + [f"--raw={message_id}"] + mail_folder_args(message_id),
                               capture_output=True, timeout=60)
            if r.returncode != 0 or not r.stdout:
                _preview["failed"][key] = time.time()
                return
            msg = email.message_from_bytes(r.stdout, policy=email.policy.default)
            source, text, cids = v.body_parts(msg)
            # its text: the text part if it has most of the words, else the HTML's own
            good = v.plain_enough(source, text) if source else text
            plain = good if good is not None else (text if text and len(text.split()) >= len(
                v.html_text(source).split()) / 2 else v.html_text(source))
            # cleaned: mail text must not reach the terminal with escape sequences
            info = {"text": cfg.clean(plain) or "(no text)", "has_html": bool(source),
                    "designed": bool(source) and good is None,
                    "source": source or f"<pre>{_html.escape(text or '')}</pre>", "cids": cids}
            if len(_mail_info) > 200:
                _mail_info.clear()
            _mail_info[message_id] = info
        if not render or not info["has_html"]:
            return
        if os.path.exists(path):
            return
        with tempfile.TemporaryDirectory(prefix="mausi-preview-") as work:
            page = v.page_html(info["source"], info["cids"], network=network)
            out = v.render(RENDER_CMD, page, work, network=network)
            if not out:
                _preview["failed"][key] = time.time()
                return
            os.makedirs(PREVIEW_DIR, mode=0o700, exist_ok=True)
            os.chmod(PREVIEW_DIR, 0o700)
            os.chmod(out[0], 0o600)  # whatever mode the renderer gave it
            shutil.move(out[0], path)
        old = sorted((os.path.join(PREVIEW_DIR, n) for n in os.listdir(PREVIEW_DIR)), key=os.path.getmtime)
        for f in old[:-PREVIEW_KEEP]:
            os.remove(f)
    except Exception:  # noqa: BLE001 — a preview must never take the dashboard down
        cfg.log_error("mail preview")
        _preview["failed"][key] = time.time()
    finally:
        _preview["busy"] = None


def save_mail(mb, kind, what):
    """Save the open mail to SAVE_DIR as shown (the rendering as PNG, a text-only
    mail as .txt), named "YYYY-MM-DD From - Subject"."""
    if kind == "failed":
        return "couldn't render it, so nothing saved"
    when = re.search(r"\d{4}-\d\d-\d\d", mb["from"])
    sender = re.sub(r"\s*<[^>]*>|\s*·.*", "", mb["from"]).strip(' "')
    name = f"{when.group(0) if when else time.strftime('%Y-%m-%d')} {sender[:40]} - {mb['subject'][:80]}"
    name = re.sub(r"[/\\\x00-\x1f\x7f]+", "-", name.replace(":", "")).strip(" .-") or "mail"
    ext = ".png" if kind == "png" else ".txt"
    os.makedirs(SAVE_DIR, exist_ok=True)
    path, n = os.path.join(SAVE_DIR, name + ext), 1
    while os.path.exists(path):  # never overwrite
        n += 1
        path = os.path.join(SAVE_DIR, f"{name} {n}{ext}")
    try:
        if kind == "png":
            shutil.copyfile(what[0], path)
        else:
            with open(path, "w", encoding="utf-8") as f:
                f.write(f"{mb['subject']}\n{mb['from']}\n\n{what}\n")
    except OSError as e:
        return f"couldn't save it: {e.strerror}"
    return f"saved: {path.replace(os.path.expanduser('~'), '~', 1)}"


def wrap_text(text, width):
    out = []
    for para in text.splitlines():
        out += textwrap.wrap(para.expandtabs(4), width, replace_whitespace=False, drop_whitespace=True) or [""]
    return out


def cell_size():
    try:
        import fcntl
        import struct
        import termios
        rows, cols, xpix, ypix = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
        return (xpix or cols * 9) / cols, (ypix or rows * 18) / rows
    except OSError:
        return 9, 18


def place_png(png, top_row, left_col, rows, width, scroll=0):
    """kitty graphics showing png (path, w, h) at its own size (narrower if
    width is less), centred in width cells from left_col, rows tall from
    top_row, starting scroll terminal rows down. Returns (escapes, rows the
    whole picture takes)."""
    import base64
    path, w, h = png
    cell_w, cell_h = cell_size()
    cols = max(1, min(width, int(w / cell_w + 0.5)))
    per_row = w / cols * cell_h / cell_w  # image pixels per terminal row
    total = max(1, int(h / per_row + 0.999))
    scroll = max(0, min(scroll, total - rows))
    y = int(scroll * per_row)
    shown = max(1, min(rows, total - scroll))
    left = left_col + (width - cols) // 2
    return (f"\033_Ga=t,f=100,t=f,i={PREVIEW_IMAGE},q=2;{base64.b64encode(path.encode()).decode()}\033\\"
            f"\033[{top_row};{left + 1}H\033_Ga=p,i={PREVIEW_IMAGE},x=0,y={y},w={w},"
            f"h={max(1, min(h - y, int(shown * per_row)))},c={cols},r={shown},C=1,q=2\033\\"), total


def mail_preview(message_id, top_row, rows, width, scroll=0):
    """The zoomed Mail section's bottom half: the selected mail, rendered if
    it's a designed mail, else its text; from scroll rows down. Returns
    (escapes, rows the whole of it takes)."""
    kind, what = mail_view(message_id, mail_html(message_id))
    if kind == "png":
        return place_png(what, top_row, 2, rows, width - 4, scroll)
    info = _mail_info.get(message_id)
    if kind in ("busy", "failed") and info:
        kind, what = "text", info["text"]  # while it renders (or if it can't)
    if kind != "text":
        return f"\033[{top_row};3H{DIM}{'no preview' if kind == 'failed' else 'loading…'}{RESET}", 0
    lines = wrap_text(what, max(20, min(width - 4, 110)))
    scroll = max(0, min(scroll, len(lines) - rows))
    return "".join(f"\033[{top_row + i};3H{clip(l, width - 4)}"
                   for i, l in enumerate(lines[scroll:scroll + rows])), len(lines)


def view_mail(message_id):
    """The mail in a kitty overlay (bin/mausi-mail-view); the Mail section is
    fetched again once it's closed (it may have been deleted)."""
    viewer = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "bin", "mausi-mail-view")
    render = ["--render", shlex.join(RENDER_CMD)] if RENDER_CMD else []
    r = subprocess.run(["kitty", "@", "launch", "--type=overlay", "--title", "mail", viewer, *render, f"--id={message_id}",
                        "--", *MAIL_CMD],
                       capture_output=True, text=True)
    window = r.stdout.strip()
    if r.returncode != 0 or not window.isdigit():
        return f"couldn't open the viewer: {(r.stderr or r.stdout).strip()[:80]}"

    def wait():
        while subprocess.run(["kitty", "@", "ls", "--match", f"id:{window}"], capture_output=True).returncode == 0:
            time.sleep(1)
        if ctx:
            ctx.refresh("mail")
    threading.Thread(target=wait, daemon=True).start()
    return ""


def mail_folder_args(message_id):
    """--folder for a search result outside the Inbox: found at once."""
    for m in (mail_search or {}).get("messages", []):
        if m.get("message_id") == message_id and m.get("folder") and m["folder"] != "INBOX":
            return ["--folder", m["folder"]]
    return []


_deleting = {}  # message id -> subject, while its delete runs


def delete_mail_in_background(ui, wakes, message_id, subject):
    """delete_mail in a thread, so the dashboard keeps going: the key line
    says what's being deleted meanwhile and the mail's row shows ⏳."""
    if message_id in _deleting:
        return "already deleting it"
    _deleting[message_id] = subject

    def run():
        try:
            said = delete_mail(message_id, subject)
        except Exception as e:  # noqa: BLE001 - say it rather than lose it with the thread
            said = f"couldn't delete it: {type(e).__name__}: {str(e)[:60]}"
        finally:
            _deleting.pop(message_id, None)
        ui.say(said, 4)
        wakes[1].set()
    threading.Thread(target=run, daemon=True).start()
    wakes[1].set()
    return None


def delete_mail(message_id, subject):
    try:
        r = subprocess.run(MAIL_CMD + [f"--delete={message_id}"] + mail_folder_args(message_id),
                           capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return "no answer from the mail server in 30 s: it may or may not be deleted"
    if r.returncode != 0:
        return f"couldn't delete it: {(r.stderr or r.stdout).strip()[:80]}"
    if mail_search:
        mail_search["messages"] = [m for m in mail_search["messages"] if m.get("message_id") != message_id]
    with lock:
        if mail:
            for key in ("unread", "messages"):
                if isinstance(mail.get(key), list):
                    mail[key] = [m for m in mail[key] if m.get("message_id") != message_id]
    if ctx:
        ctx.refresh("mail")
        ctx.refresh("mail_sync")  # the local copy follows (if there is one)
    return f"deleted: {subject[:60]}"


def perform(action, verb="open"):
    if not action:
        return
    if verb == "full" and action.get("message_id") and MAIL_VIEWER:
        return view_mail(action["message_id"])
    if verb == "open" and action.get("dir"):  # a task's worktree: a shell tab there
        subprocess.run(["kitty", "@", "launch", "--type=tab", "--tab-title", os.path.basename(action["dir"]),
                        "--cwd", action["dir"]], capture_output=True)
    elif verb == "open" and action.get("claude_dir"):
        path = action["claude_dir"]
        name = os.path.basename(path)
        # Two processes on one conversation corrupt it: no second launch while
        # the first tab isn't in Sessions yet, and none at all when a session
        # already runs in that folder (Sessions refreshes only every few seconds).
        if time.time() - _launched.get(path, 0) < LAUNCH_GRACE:
            return f"Claude is starting in {name}"
        if any(os.path.realpath(cwd) == path for _, cwd, _ in snapshots.live_records()):
            return f"a Claude session already runs in {name}: it'll show in Sessions"
        _launched[path] = time.time()
