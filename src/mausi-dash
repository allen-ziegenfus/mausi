def search_lines(lines, query, deep=False):
    """A zoomed section filtered to the entries matching query (case-insensitive,
    every word must appear). An entry is an actionable line plus the detail lines
    under it; the heading always stays. Matches are underlined. deep (the task
    list): every line is its own entry, group headings go, and an entry also
    matches on its details (the task's notes)."""
    words = query.lower().split()
    if not words:
        return lines
    entries, current = [], []
    if deep:
        lines = lines[:1] + [line for line in lines[1:] if line[1]]
    for line in lines[1:]:
        if line[1] and current:
            entries.append(current)
            current = []
        current.append(line)
    if current:
        entries.append(current)

    pattern = re.compile("|".join(re.escape(w) for w in sorted(words, key=len, reverse=True)), re.I)

    def underline(text):
        return "".join(token if ANSI.fullmatch(token) else pattern.sub(lambda m: f"\033[4m{m.group(0)}\033[24m", token)
                       for token in ANSI.split(text))

    found = []
    for entry in entries:
        plain = " ".join(ANSI.sub("", text) for text, _ in entry).lower()
        if deep:
            plain += " " + " ".join(str(action.get("detail", "")) for _, action in entry if action).lower()
        if all(word in plain for word in words):
            found += [(underline(text), action) for text, action in entry]
    return lines[:1] + (found or [(f"{DIM}  no matches{RESET}", None)])


_store = {"module": None}


def store():
    """mausi_tasks.py (the task store), next to this script.
    Reloaded when the file changes, so a long-running dashboard never keeps
    old code (it re-links <task>/code/ every minute)."""
    if _store["module"] is None:
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import mausi_tasks
        _store["module"] = mausi_tasks
        _store["mtime"] = os.path.getmtime(mausi_tasks.__file__)
    else:
        try:
            mtime = os.path.getmtime(_store["module"].__file__)
            if mtime != _store.get("mtime"):
                import importlib
                _store["module"] = importlib.reload(_store["module"])
                _store["mtime"] = mtime
        except (OSError, SyntaxError, ImportError):
            pass  # keep the loaded module until the file is good again
    return _store["module"]


