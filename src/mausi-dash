def board_get(path):
    try:
        data = cfg.clean(cfg.board_get(path))
        return None if not isinstance(data, dict) or data.get("error") else data
    except Exception:  # noqa: BLE001
        return None


def sentence(text):
    text = text.strip()
    text = text[:1].upper() + text[1:]
    return text if text[-1:] in ".!?" else text + "."



def new_task_entry(text):
    """A tasks.md item from what was typed: a PR URL or a Jira key is looked up
    (title, author, links) through the board; anything else is used as is."""
    today = time.strftime("%Y-%m-%d")
    pr = PR_URL_RE.search(text)
    key = TICKET_RE.search(text) if not pr else None
    rest = " ".join(PR_URL_RE.sub("", text).split())
    if pr:
        owner, repo, number = pr.groups()
        url = f"https://github.com/{owner}/{repo}/pull/{number}"
        d = board_get(f"pr/{owner}/{repo}/{number}") or {}
        title = d.get("title", "")
        mine = d.get("author") == GITHUB_ME
        head = f"{'Follow up on' if mine else 'Review'} {owner}/{repo}#{number}" + (f" — {title}" if title else "")
        facts = [f"PR by {d['author']}, opened {d['created'][:10]}" if d.get("author") else "", rest]
        links = [url]
        ticket = TICKET_RE.match(title)
        if ticket:
            links.append(f"Jira: {JIRA_BROWSE}{ticket.group(1)}")
    elif key and text.strip().startswith(key.group(1)):
        k = key.group(1)
        d = board_get(f"issue/{k}") or {}
        head = f"{k} — {d['summary']}" if d.get("summary") else text.strip()
        facts = [f"{d['status']}, assignee {d.get('assignee') or 'nobody'}" if d.get("status") else "",
                 text.strip()[len(k):].strip(" —-:") if d.get("summary") else ""]
        links = [f"Jira: {JIRA_BROWSE}{k}"]
    else:
        head, facts, links = text.strip(), [], []
    body = " ".join(sentence(f) for f in facts if f)
    line = f"- [ ] **{sentence(head)}**" + (f" {body}" if body else "") + (" " + " · ".join(links) if links else "")
    return [line, f"  - Added: {today}"], head


def add_to_task(ref, new_lines):
