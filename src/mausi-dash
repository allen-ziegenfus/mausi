def mail_task_seed(m):
    """What t offers for a mail: a Jira key in the subject (Jira mail) or a PR URL
    in the body (GitHub mail), looked up like a typed one; else a reply line."""
    pr = PR_URL_RE.search(m.get("body") or "")
    key = TICKET_ANY_RE.search(m["subject"])
    if pr and re.match(r"(Re: )?\[[\w.-]+/[\w.-]+\]", m["subject"]):  # GitHub: "[owner/repo] ..."
        title = "https://github.com/{}/{}/pull/{}".format(*pr.groups())
    elif key:
        title = key.group(0)
    else:
        title = f"Reply to {m['from']}: {m['subject']}"
    excerpt = " ".join((m.get("body") or "").split())[:400]
    return {"title": title, "source": "mail",
            "context": [f"From mail, {m['from']}, {m['date'].replace('T', ' ')}: {m['subject']} · {m['url']}"
                        + (f" — {excerpt}{'…' if len(m.get('body') or '') > 400 else ''}" if excerpt else "")]}


mail_search = None  # {"query", "busy", "messages", "error"}: S, the zoomed Mail section shows it


def start_mail_search(query):
    """S: every folder searched on the server (the mail command's --search)."""
    global mail_search
    mail_search = {"query": query, "busy": True, "messages": [], "error": ""}
    mine = mail_search

    def run():
        try:
            r = subprocess.run(MAIL_CMD + ["--search", query], capture_output=True, text=True, timeout=120)
            mine["messages"] = cfg.clean(json.loads(r.stdout)).get("messages", []) if r.returncode == 0 else []
            if r.returncode != 0:
                mine["error"] = (r.stderr.strip().splitlines() or ["search failed"])[-1][:100]
        except (OSError, ValueError, subprocess.TimeoutExpired) as e:
            mine["error"] = str(e)[:100]
        mine["busy"] = False
    threading.Thread(target=run, daemon=True).start()


