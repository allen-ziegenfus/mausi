def pod_containers(pod):
    """Container statuses as kubectl counts them: native sidecars (init
    containers with restartPolicy: Always) count toward READY."""
    sidecars = {c["name"] for c in pod["spec"].get("initContainers", [])
                if c.get("restartPolicy") == "Always"}
    return pod["status"].get("containerStatuses", []) + [
        c for c in pod["status"].get("initContainerStatuses", []) if c["name"] in sidecars]


def pod_state(pod):
    """(ready "1/2", status word, restarts, healthy) like kubectl get pods."""
    statuses = pod_containers(pod)
    ready = sum(1 for c in statuses if c.get("ready"))
    restarts = sum(c.get("restartCount", 0) for c in statuses)
    status = pod["status"].get("phase", "?")
    for c in statuses:
        waiting = c.get("state", {}).get("waiting")
        if waiting:
            status = waiting.get("reason", status)
    if pod["metadata"].get("deletionTimestamp"):
        status = "Terminating"
    healthy = status == "Succeeded" or (status == "Running" and ready == len(statuses))
    return f"{ready}/{len(statuses)}", status, restarts, healthy


def kube_lines(kube, detail=False):
    if not kube:
        return []
    ctx = kube["ctx"]
    if kube["pods"] is None:
        return [(f"{BOLD}Kubernetes{RESET} {ctx} {RED}unreachable{RESET}", None)]

    node_bits = []
    for n in kube["nodes"]:
        ready = any(c["type"] == "Ready" and c["status"] == "True" for c in n["status"].get("conditions", []))
        version = n["status"].get("nodeInfo", {}).get("kubeletVersion", "")
        node_bits.append(f"{n['metadata']['name']} {GREEN + 'Ready' if ready else RED + 'NotReady'}{RESET}"
                         f" {DIM}{version}{RESET}")

    items = kube["pods"]
    unhealthy = [p for p in items if not pod_state(p)[3]]
    summary = f"{GREEN}all healthy{RESET}" if not unhealthy else f"{YELLOW}{len(unhealthy)} not ready{RESET}"
    lines = [(f"{BOLD}Kubernetes{RESET} {ctx} {DIM}·{RESET} " + ", ".join(node_bits)
              + f" {DIM}· {len(items)} pods{RESET} {summary}", None)]

    system = [p for p in items if p["metadata"]["namespace"] == "kube-system"]
    for pod in items:
        ns, name = pod["metadata"]["namespace"], pod["metadata"]["name"]
        ready, status, restarts, healthy = pod_state(pod)
        if ns == "kube-system" and healthy and not detail:
            continue
        # Deployment pods are <deployment>-<rs hash>-<pod hash>; the service
        # usually shares the deployment's name.
        app = re.sub(r"-[a-z0-9]{8,10}-[a-z0-9]{5}$", "", name)
        host = kube["hosts"].get(f"{ns}/{app}")
        action = {"shell": ["kubectl", "exec", "-it", "-n", ns, name, "--", *SHELL_CMD], "name": name,
                  "detail": (f"{ns}/{name}", "\n".join(
                      f"{c['name']}: {next(iter(c.get('state', {})), '?')}, ready={c.get('ready')}, "
                      f"restarts={c.get('restartCount', 0)}\n{c.get('image', '')}" for c in pod_containers(pod)))}
        if host:
            action["open"] = f"http://{host}"
        dot = f"{GREEN}●{RESET}" if healthy else f"{RED}●{RESET}"
        restart_note = f" {YELLOW}↻{restarts}{RESET}" if restarts else ""
        lines.append((f"  {dot} {ns + '/' if ns != 'default' else ''}{app:<28} {ready:<4} "
                      f"{GREEN if healthy else RED}{status:<10}{RESET} {DIM}{pod_age(pod['metadata']['creationTimestamp']):>4}{RESET}"
                      f"{restart_note}  {DIM}{host or ''}{RESET}", action))
        if detail:
            lines += sub(f"pod {name} · node {pod['spec'].get('nodeName', '?')} · ip {pod['status'].get('podIP', '—')}")
            for c in pod_containers(pod):
                state = next(iter(c.get("state", {})), "?")
                reason = c.get("state", {}).get(state, {}).get("reason", "")
                lines += sub(f"▸ {c['name']}: {state}{' (' + reason + ')' if reason else ''}"
                             f"{' ready' if c.get('ready') else ' not ready'} · restarts {c.get('restartCount', 0)}"
                             f" · {c.get('image', '')}", indent=8)
    healthy_system = sum(1 for p in system if pod_state(p)[3])
    if healthy_system and not detail:
        lines.append((f"  {DIM}kube-system: {healthy_system} pods healthy{RESET}", None))
    return lines


def age(item):
    """Days since a PR or ticket was opened, as a 4-cell column: dim under a
    week, yellow under a month, red after."""
    try:
        days = int((time.time() - time.mktime(time.strptime(item["created"], "%Y-%m-%d"))) // 86400)
    except (KeyError, TypeError, ValueError):
        return " " * 4
    color = DIM if days < 7 else YELLOW if days < 30 else RED
    return f"{color}{days:>3}d{RESET}"


def pr_state(pr):
    """The PR state column: OPEN, DRAFT, MERGED or CLOSED, fixed width, coloured."""
    if pr.get("merged"):
        return f"{GREEN}MERGED{RESET}"
    if pr.get("forwarded"):
        return f"{DIM}FWD'ED{RESET}"
    if pr.get("superseded"):
        return f"{DIM}SUPERS{RESET}"
    if pr.get("closed"):
        return f"{RED}{DIM}CLOSED{RESET}"
    if pr.get("draft"):
        return f"{DIM}DRAFT {RESET}"
    return f"{CYAN}OPEN  {RESET}"


def pr_line(pr):
    tags = []
    ci = pr.get("ci")
    if ci:
        color = GREEN if ci == "SUCCESS" else RED if ci in ("FAILURE", "ERROR") else YELLOW
        tags.append(f"{color}CI {ci.lower()}{RESET}")
    review = pr.get("review")
    if review:
        color = GREEN if review == "APPROVED" else RED if review == "CHANGES_REQUESTED" else DIM
        tags.append(f"{color}{review.replace('_', ' ').lower()}{RESET}")
    if pr.get("last_comment"):
        tags.append(f"{DIM}💬 {pr['last_comment']}{RESET}")
    action = {"open": pr["url"], "detail": (pr["ref"], pr["title"]), "pr": pr["ref"]}
    key = TICKET_RE.match(pr["title"])
    if key:
        action.update(ticket=key.group(1), repo=pr["ref"].split("/", 1)[1].split("#")[0])
    return (f"  {pr_state(pr)} {age(pr)} {pr['title']}  {DIM}{pr['ref']}{RESET}  " + " ".join(tags), action)


def fetch_detail(path, force=False):
    """Fill issues[path] from the board's /api/<path> (issue/<KEY>, pr/<o>/<r>/<n>)."""
    hit = issues.get(path)
    if hit and (hit[1] is None or (not force and time.time() - hit[0] < ISSUE_TTL)):
        return  # a fetch already running (None), or fresh
    issues[path] = (time.time(), hit[1] if hit else None)
    try:
        data = cfg.clean(cfg.board_get(path))
    except Exception as e:  # noqa: BLE001 — any failure must clear the "loading" marker
        data = {"error": str(e) or type(e).__name__}
    issues[path] = (time.time(), data)


def fetch_detail_async(path, force=False):
    threading.Thread(target=fetch_detail, args=(path, force), daemon=True).start()


def fetch_issue_async(key, force=False):
    fetch_detail_async(f"issue/{key}", force)


