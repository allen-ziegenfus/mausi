PROJECT_COLS = (24, 4, 18, 4, 5, 9)  # folder, last, branch, uncommitted, tasks, worktrees


def project_row(p, row, indent, detail):
    """One folder as fixed columns under the header row (padded before
    colouring, so the escape codes don't shift them)."""
    w_name, w_last, w_branch, w_changes, w_tasks, w_wt = PROJECT_COLS
    mark = f"{CYAN}›{RESET}" if row else " "
    branch = (p["branch"] if p["branch"] not in ("main", "master") else "") if p["git"] else "no git"
    if p["git"] and p["branch"] == "HEAD":
        branch = f"detached {p.get('commit', '')}".strip()
    elif p["git"] and not p["branch"]:
        branch = "no commits"
    branch_col = f"{fit(branch, w_branch):<{w_branch}}"
    changes = f"●{p['changes']}" if p["changes"] else ""
    tasks = str(len(p["tasks"])) if p.get("tasks") else ""
    wts = f"+{len(p['worktrees'])}" if not detail and p.get("worktrees") else ""
    where = ""
    if row:
        where = f"  {DIM}session in {'tab ' + str(row['tab']) if row.get('tab') else row.get('where')}{RESET}"
    name_w = w_name - (len(indent) - 2)  # worktrees sit deeper; keep the columns where they are
    return (f"{indent}{mark} {fit(p['name'], name_w):<{name_w}} {DIM}{ago(p['last']):>{w_last}}{RESET}  "
            f"{(MAGENTA if p['git'] else DIM)}{branch_col}{RESET} "
            f"{YELLOW}{changes:>{w_changes}}{RESET} {CYAN}{tasks:>{w_tasks}}{RESET} {DIM}{wts:>{w_wt}}{RESET}{where}",
            project_action(p, row))


