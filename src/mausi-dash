def delete_note(path, line, name):
    """Remove the snippet (its "## " heading through the next one) or the quick
    note at `line`, if that line still holds it."""
    lines = read_lines(path)
    if line > len(lines) or name not in lines[line - 1]:
        return "not deleted: the file changed — r to refresh"
    start, end = line - 1, line
    if path == SNIPPETS_MD:
        while end < len(lines) and not lines[end].startswith("## "):
            end += 1
        while start > 0 and not lines[start - 1].strip():
            start -= 1
    del lines[start:end]
    write_atomic(path, "\n".join(lines).strip("\n") + "\n" if lines else "")
    return f"deleted: {name[:60]}"


