def pr_lines(data, detail=False):
    if not data.get("error") and "mine" not in data and "involved" not in data:
        return []
    if data.get("error"):
        return [(f"{BOLD}PRs{RESET} {RED}{data['error']}{RESET}", None)]

    def rows(prs):
        out = []
        for pr in prs:
            out.append(pr_line(pr))
            if detail:
                out += sub(f"{pr['ref']} · CI {(pr.get('ci') or '—').lower()} · review "
                           f"{(pr.get('review') or 'none').replace('_', ' ').lower()} · last comment "
                           f"{pr.get('last_comment') or '—'} · opened {pr.get('created', '?')} · updated {pr['updated']}"
                           + (" · draft" if pr["draft"] else ""))
        return out

    lines = []
    # Tickets already closed in Jira (recently closed) don't need closing again.
    done = {j["key"] for j in (data.get("recent") or {}).get("jira", [])}
    to_close = [i for i in data.get("to_close") or [] if i.get("jira") not in done]
    if to_close:
        lines.append((f"{BOLD}{YELLOW}Merged — close in Jira ({len(to_close)}){RESET}", None))
        for i in to_close:
            action = {"open": JIRA_BROWSE + i["jira"]} if i.get("jira") else {"open": BOARD_URL}
            # Like a Jira row, so c, w, a and Space work on it too.
            if i.get("jira"):
                action.update(ticket=i["jira"], issue=i["jira"], repo="",
                              detail=(f"{i['jira']} · merged, close in Jira",
                                      f"{i['title']}\nPR: {i.get('id') or '?'} (merged)"))
            elif i.get("id"):
                action.update(pr=i["id"], detail=(i["id"], f"{i['title']}\n(merged)"))
            lines.append((f"  {YELLOW}●{RESET} {i['jira'] or ''} {i['title']}", action))
        lines.append(("", None))
    if data.get("forwards"):
        lines.append((f"{BOLD}Waiting on {FORWARD_NAME}{RESET} {DIM}({len(data['forwards'])}){RESET}", None))
        lines += rows(data["forwards"])
        lines.append(("", None))
    lines.append((f"{BOLD}My PRs{RESET} {DIM}({len(data.get('mine') or [])}){RESET}"
                  + (f" {RED}{data['pr_error'][:80]}{RESET}" if data.get("pr_error") else ""), None))
    lines += rows(data.get("mine") or [])
    involved = data.get("involved") or []
    if involved or data.get("involved_error") or data.get("involved_loading"):
        lines.append(("", None))
        lines.append((f"{BOLD}Involved{RESET} {DIM}(" + ("others' PRs in your repos" if data.get("source") == "github" else
                                                          "others' PRs: review requested, mention you, or name your tickets")
                       + (f" · {len(involved)}" if involved else "")
                       + (" · looking…" if data.get("involved_loading") else "") + f"){RESET}"
                       + (f" {RED}{data['involved_error'][:80]}{RESET}" if data.get("involved_error") else ""), None))
        for pr in involved:
            text, action = pr_line(pr)
            lines.append((text + "  " + why_tag(pr), action))
            if detail:
                lines += sub(f"{pr['ref']} · by {pr.get('author') or '?'} · why: {', '.join(pr.get('why') or [])}"
                             f" · opened {pr.get('created', '?')} · updated {pr['updated']}")
    # The heading that names the section is whichever came first.
    return lines


def board_lines(data, detail=False):
    """Boards (the board's "boards", e.g. GitHub Projects from mausi-github or
    TODO files from mausi-todos): the items in the moving statuses, with a count
    of the rest. "projects" is the key's old name."""
    key = "boards" if "boards" in data else "projects"
    if data.get("error") or key not in data:  # the PRs section shows the error
        return []
    lines = []
    for p in data.get(key) or []:
        rest = ", ".join(f"{n} {s}" for s, n in sorted(p["counts"].items(),
                         key=lambda kv: p["statuses"].index(kv[0]) if kv[0] in p["statuses"] else 99) if s not in p["shown"])
        if lines:
            lines.append(("", None))
        lines.append((f"{BOLD}{p['title']}{RESET} {DIM}({len(p['items'])}" + (f" · {rest}" if rest else "") + f"){RESET}",
                      {"open": p["url"]} if p.get("url") else {"edit": (p["file"], 1)} if p.get("file") else None))
        status = None
        has_prio = any(i.get("priority") for i in p["items"])  # TODO files have none: no column
        for i in p["items"]:
            if i["status"] != status:
                status = i["status"]
                lines.append((f"  {CYAN}{status}{RESET}", None))
            prio = {"hoch": RED, "high": RED, "mittel": YELLOW, "medium": YELLOW}.get(i["priority"].lower(), DIM)
            where = i["url"] or (f"{i['file']}:{i['line']}" if i.get("file") else "")
            action = {"open": i["url"]} if i["url"] else {"edit": (i["file"], i.get("line") or 1)} if i.get("file") else {}
            action["detail"] = (i["ref"] or i["status"], f"{i['title']}\n\n{i['status']}"
                                                   + (f" · priority {i['priority']}" if i["priority"] else "")
                                                   + (f" · {', '.join(i['assignees'])}" if i["assignees"] else "")
                                                   + (f" · updated {i['updated']}" if i.get("updated") else "") + f"\n{where}")
