def task_sections_md():
    """All open sections of tasks.md with each item's indented detail lines."""
    try:
        text = open(TASKS_MD).read()
    except OSError:
        return []
    sections, item, in_open = [], None, False
    for n, line in enumerate(text.splitlines(), 1):
        if line.startswith("## "):
            in_open = line.strip() == "## Open"
            continue
        if not in_open:
            continue
        if line.startswith("### "):
            sections.append({"title": line[4:].split(" (")[0].strip(), "items": []})
            item = None
        elif line.startswith("- "):
            m = re.match(r"- (\[( |x)\] )?(.*)", line)
            if m.group(2) == "x":
                item = None
                continue
            if not sections:
                sections.append({"title": "Unsorted", "items": []})
            item = {"head": m.group(3), "lines": [], "line": n}
            sections[-1]["items"].append(item)
        elif item is not None and line.strip() and "OPEN-CLAUDE-SESSIONS" not in line:
            m = re.fullmatch(r"\s*- ID: (\S+)", line)
            if m:
                item["id"] = m.group(1)
            item["lines"].append(line.strip().lstrip("- "))
    return [s for s in sections if s["items"]]


def plain(md):
    return re.sub(r"\*\*(.+?)\*\*|`([^`]+)`", lambda m: m.group(1) or m.group(2), md)


def task_lines(data, detail=False, width=None, only=None):
    """The Tasks section, or with `only` just that tasks.md section (the pinned
    "Now" tasks get their own section, highlighted, just above Tasks)."""
    if detail and not only:
        lines = [(f"{BOLD}Tasks{RESET} {DIM}(all of tasks.md){RESET}", dict(BOARD_TASKS))]
        for sec in task_sections_md():
            lines.append(("", None))
            lines.append((f"{BOLD}{sec['title']}{RESET} {DIM}({len(sec['items'])}){RESET}", None))
            for it in sec["items"]:
                if any(h in it["head"] for h in TASK_HIDE):
                    continue
                head = plain(it["head"])
                title = re.match(r"\*\*(.+?)\*\*", it["head"])
                key = TICKET_RE.match(plain(title.group(1) if title else head).lstrip("★ "))
                action = ticket_action(data, key.group(1)) if key else dict(BOARD_TASKS)
                action["detail"] = (sec["title"], "\n".join([head] + [plain(l) for l in it["lines"]]))
                action["task"] = (title.group(1) if title else head).strip()
                action["task_ref"] = it.get("id")
                action["edit"] = (TASKS_MD, it["line"])
                lines.append((f"  • {head}", action))
                for extra in it["lines"][:4]:
                    lines += sub(plain(extra), width)
                if len(it["lines"]) > 4:
                    lines += sub(f"… {len(it['lines']) - 4} more lines (Space)")
        return lines

    if not BOARD_URL:
        # No board: the same shape it sends, read from the overview.
        data = {"tasks": [{"title": sec["title"],
                           "items": [(m.group(1) if (m := re.match(r"\*\*(.+?)\*\*", it["head"])) else plain(it["head"])).strip()
                                     for it in sec["items"]]} for sec in task_sections_md()]}
    elif data.get("error"):
        return []
    # The board only sends titles; the full entry comes from tasks.md itself.
    entries = {}  # title -> [(section, item)], in order: titles can repeat
    for sec in task_sections_md():
        for it in sec["items"]:
            bold = re.match(r"\*\*(.+?)\*\*", it["head"])
            entries.setdefault((bold.group(1) if bold else plain(it["head"])).strip(), []).append((sec["title"], it))
    lines, counts = [], []
    for sec in data["tasks"]:
        if not sec["items"] or (sec["title"] == "Now") != bool(only):
            continue
        if only or sec["title"].startswith(TASK_SECTIONS):
            if only:  # pinned: black on yellow heading, bold rows behind a yellow bar
                lines.append((f"{PIN_HEAD} {sec['title'].split(' (')[0].upper()} {RESET} {DIM}pinned · t to unpin{RESET}", None))
            else:
                lines.append((f"{BOLD}{sec['title'].split(' (')[0]}{RESET}", None))
            for t in sec["items"]:
                if any(h in t for h in TASK_HIDE):
                    continue
                key = TICKET_RE.match(t.lstrip("★ "))
                action = ticket_action(data, key.group(1)) if key else dict(BOARD_TASKS)
                action["task"] = t.strip()
                same = entries.get(t.strip())
                entry = same.pop(0) if same else None
                if entry:
                    title, it = entry
                    action["task_ref"] = it.get("id")
                    action["detail"] = (title, "\n".join([plain(it["head"])] + [plain(l) for l in it["lines"]]))
                    action["edit"] = (TASKS_MD, it["line"])
                else:
                    action["detail"] = (sec["title"].split(" (")[0], t)
                lines.append((f"  {YELLOW}▌{RESET} {BOLD}{t}{RESET}" if only else f"  • {t}", action))
        else:
            counts.append(f"{sec['title'].split(' (')[0]} {len(sec['items'])}")
    if counts:
        lines.append((f"{DIM}also in tasks.md: " + " · ".join(counts) + f" — z for all{RESET}",
                      dict(BOARD_TASKS)))
    return lines


