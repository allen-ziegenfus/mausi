        append_text(QUICK_MD, "# Quick notes\n\n")
    append_text(QUICK_MD, f"- {time.strftime('%Y-%m-%d %H:%M')} · {text}\n")


def file_text(path, limit=256 << 10):
    """(text, is_text) of a file for the popup: its contents, or a note for
    binary and large files."""
    try:
        with open(path, "rb") as f:
            data = f.read(limit + 1)
    except OSError as e:
        return f"can't read it: {e.strerror}", False
    if b"\0" in data[:8192]:
        return "binary file — Enter opens it, c copies its path", False
    text = data[:limit].decode(errors="replace")
    return (text + ("\n\n… (only the start is shown; c copies all of it)" if len(data) > limit else "")), True


def copy_popup(popup):
    """c in the details popup: a task's whole TASK.md, a task file's contents
    (its path if binary), else the text shown."""
    title, text, action = popup
    task = store().find(task_ref(action)) if action.get("task") else None
    if action.get("file"):
        body, is_text = file_text(action["file"], 16 << 20)
        name = os.path.basename(action["file"])
        text, what = (body, name) if is_text else (action["file"], f"the path of {name}")
    elif task:
        text, what = open(task["path"]).read(), f"{task['id']}/TASK.md"
    else:
        if action.get("issue"):
            text = issue_text(action["issue"], action["detail"][1])
        elif action.get("pr"):
            text = pr_text(action["pr"], action["detail"][1])
