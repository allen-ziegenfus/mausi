def pr_text(ref, title):
    """The pop-up body for a PR: facts, description, checks, conversation."""
    d = detail_data(pr_path(ref))
    if d is None:
        return f"{title}\n\nloading description and comments…"
    if d.get("error"):
        return f"{title}\n\nCould not load the PR: {d['error'][:200]}"
    review = (d.get("review") or "no review decision").replace("_", " ").lower()
    out = [d["title"], "", f"{d['state']} · {d['author']} · {d['branch']} · {d['changes']} · {review}"
           f" · opened {d['created']} · updated {d['updated']}", "", "DESCRIPTION", "", d["body"] or "(none)"]
    if d["checks"]:
        failing = [c for c in d["checks"] if not c.endswith((": success", ": skipped", ": neutral"))]
        out += ["", f"CHECKS ({len(d['checks'])}, {len(failing)} not passing)"] + ["  " + c for c in (failing or d["checks"])[:15]]
    out += ["", f"CONVERSATION ({len(d['comments'])})"]
    for c in reversed(d["comments"]):
        out += ["", f"— {c['author']} · {c['created']} · {c['kind']}", c["body"] or "(no text)"]
    out += ["", f"FILES ({d['changes']})"] + ["  " + f for f in d["files"]]
    return "\n".join(out)


def issue_text(key, summary):
    """The pop-up body for a ticket: facts, description, latest comments."""
    d = issue_data(key)
    if d is None:
        return f"{summary}\n\nloading description and comments…"
    if d.get("error"):
        return f"{summary}\n\nCould not load the ticket: {d['error'][:200]}"
    facts = " · ".join(x for x in (
        d.get("type"), d.get("priority") and f"priority {d['priority']}",
        d.get("assignee") and f"assignee {d['assignee']}", d.get("reporter") and f"reporter {d['reporter']}",
        d.get("parent") and f"parent {d['parent']}", f"updated {d['updated']}") if x)
    out = [d["summary"], "", facts, "", "DESCRIPTION", "", d["description"] or "(none)"]
    shown = len(d["comments"])
    out += ["", f"COMMENTS ({d['comment_count']}" + (f", latest {shown}" if shown < d["comment_count"] else "") + ")"]
    for c in reversed(d["comments"]):
        out += ["", f"— {c['author']} · {c['created']}", c["body"]]
    if not d["comments"]:
        out.append("(none)")
    return "\n".join(out)


def read_lines(path):
    try:
        with open(path) as f:
            return f.read().splitlines()
    except OSError:
        return []


