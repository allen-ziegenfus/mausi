def run(cmd, timeout=5):
    try:
        out = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout)
        return out.stdout if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def kitty_ls():
    out = run(["kitty", "@", "ls"])
    try:
        return json.loads(out) if out else []
    except json.JSONDecodeError:
        return []


def git_branch(cwd):
    out = run(["git", "-C", cwd, "symbolic-ref", "--quiet", "--short", "HEAD"], 2)
    return out.strip() if out else ""


def session_id(window):
    sid = window.get("user_vars", {}).get("claude_session")
    if sid:
        return sid
    for proc in window.get("foreground_processes", []):
        cmd = proc.get("cmdline", [])
        for i, arg in enumerate(cmd):
            if arg in ("--resume", "-r") and i + 1 < len(cmd):
                return cmd[i + 1]
            if arg.startswith("--resume="):
                return arg.split("=", 1)[1]
    # A fresh `claude` (e.g. one started with c): Claude Code records each
    # process's session id in ~/.claude/sessions/<pid>.json.
    for proc in window.get("foreground_processes", []):
        try:
            with open(os.path.join(HOME, ".claude", "sessions", f"{proc.get('pid')}.json")) as f:
                sid = json.load(f).get("sessionId")
        except (OSError, ValueError):
            continue
        if sid:
            return sid
    return ""


def is_claude(window):
    if window.get("user_vars", {}).get("claude_session"):
        return True
    for proc in window.get("foreground_processes", []):
        cmd = proc.get("cmdline", [])
        if cmd and os.path.basename(cmd[0]) == "claude":
            return True
    return False


BUSY_STALE = 10 * 60  # a working mark older than this (no transcript write) is ignored


def transcript_path(cwd, sid):
    proj = os.path.join(PROJECTS, re.sub(r"[^A-Za-z0-9]", "-", cwd))
    if sid:
        return os.path.join(proj, sid + ".jsonl")
    try:
        return max((os.path.join(proj, f) for f in os.listdir(proj) if f.endswith(".jsonl")),
                   key=os.path.getmtime)
    except (OSError, ValueError):
        return ""


def transcript_seconds(cwd, sid):
    """Seconds since the session's transcript last changed (inf if unknown)."""
    try:
        return time.time() - os.path.getmtime(transcript_path(cwd, sid))
    except OSError:
        return float("inf")


def transcript_age(seconds):
    """A transcript_seconds() value as "now", "5m", "3h", "2d" ("" if unknown)."""
    if seconds == float("inf"):
        return ""
    if seconds < 60:
        return "now"
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 86400:
        return f"{int(seconds // 3600)}h"
    return f"{int(seconds // 86400)}d"


def sessions():
    rows = []
    background = snapshots.background_tasks()
    for os_window in kitty_ls():
        for index, tab in enumerate(os_window.get("tabs", []), 1):
            for window in tab.get("windows", []):
                if not is_claude(window):
                    continue
                cwd = window.get("cwd", "")
                branch = git_branch(cwd)
                match = TICKET_RE.match(branch)
                sid = session_id(window)
                seconds = transcript_seconds(cwd, sid)
                rows.append({
                    "tab": index,
                    "tab_id": tab["id"],
                    "title": window.get("user_vars", {}).get("claude_title") or tab.get("title", ""),
                    "task_var": window.get("user_vars", {}).get("claude_task", ""),
                    "active": tab.get("is_active"),
                    "wait": window.get("user_vars", {}).get("claude_wait") == "1",
                    # Set by the hooks between your prompt and Claude's Stop. Esc
                    # skips Stop, so trust it only while the transcript is moving.
                    "busy": (window.get("user_vars", {}).get("claude_busy") == "1"
                             and seconds < BUSY_STALE),
                    "bg": background.get(sid, 0),
                    "window_id": window["id"],
                    "tab_title": tab.get("title", ""),
                    "ticket": match.group(1) if match else "",
                    "branch": branch,
                    "cwd": cwd.replace(HOME, "~", 1),
                    "sid": sid[:8],
                    "sid_full": sid,
                    "cwd_full": cwd,
                    "age": transcript_age(seconds),
                })
                break
    try:
        sync_tab_marks(rows)
    except Exception:  # noqa: BLE001 — marks are cosmetic; the list must still draw
        cfg.log_error("sync_tab_marks")
    rows += outside_sessions({r["sid_full"] for r in rows})
    return rows


_host_apps = {}  # pid -> app it runs in (a pid's app doesn't change)


def outside_sessions(in_kitty):
    """Sessions running outside kitty (Terminal, VS Code, ...): listed so they
    can be seen and attached, but they have no tab to jump to."""
    rows = []
    for pid, cwd, sid in snapshots.live_records():
        if sid in in_kitty:
            continue
        if pid not in _host_apps:
            _host_apps[pid] = snapshots.host_app(pid) or "another terminal"
        rows.append({
            "tab": None, "tab_id": None, "where": _host_apps[pid], "pid": pid,
            "title": os.path.basename(cwd), "task_var": "", "active": False, "wait": False,
            "ticket": "", "branch": git_branch(cwd),
            "cwd": cwd.replace(HOME, "~", 1), "sid": sid[:8], "sid_full": sid, "cwd_full": cwd,
            "age": transcript_age(transcript_seconds(cwd, sid)),
        })
    return rows


def load_jira_cache():
    try:
        with open(JIRA_CACHE) as f:
            jira.update({k: v for k, v in json.load(f).items() if v})  # "" = an old failed lookup: fetch again
    except (OSError, json.JSONDecodeError):
        pass


_jira_busy = threading.Lock()
_jira_failed = {}  # key -> when a lookup last failed (network, auth): retried after JIRA_RETRY
JIRA_RETRY = 300


def fetch_jira(keys):
    """Fill in ticket summaries once per key; silently skipped without creds.
    One fetch at a time (the session poll starts one every few seconds)."""
    user = os.environ.get("JIRA_API_USER")
    token = os.environ.get("JIRA_API_TOKEN")
    now = time.time()
    missing = [k for k in keys if k and k not in jira and now - _jira_failed.get(k, 0) > JIRA_RETRY]
    if not (user and token and missing and JIRA_SITE) or not _jira_busy.acquire(blocking=False):
        return
    try:
        for key in missing:
            # The credentials go in on stdin (curl --config -), not the command
            # line, where other users could read them in ps.
            try:
                r = subprocess.run(["curl", "--silent", "--fail", "--config", "-",
                                    "--url", f"{JIRA_SITE}/rest/api/3/issue/{key}?fields=summary,status"],
                                   input='user = "' + f"{user}:{token}".replace("\\", "\\\\").replace('"', '\\"') + '"\n', capture_output=True, text=True, timeout=10)
                out = r.stdout if r.returncode == 0 else None
            except (OSError, subprocess.TimeoutExpired):
                out = None
            try:
                fields = cfg.clean(json.loads(out)["fields"])
                jira[key] = f'{fields["summary"]} [{fields["status"]["name"]}]'
            except (TypeError, KeyError, json.JSONDecodeError):
                _jira_failed[key] = time.time()  # not cached: try again later
        write_atomic(JIRA_CACHE, json.dumps(jira))
    finally:
        _jira_busy.release()


