def append_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        f.write(text)


def snippets():
    """[{title, body, line}] from snippets.md; a body that is one fenced block
    is copied without its fences."""
    out, cur = [], None
    for n, line in enumerate(read_lines(SNIPPETS_MD), 1):
        if line.startswith("## "):
            cur = {"title": line[3:].strip(), "body": [], "line": n}
            out.append(cur)
        elif cur is not None:
            cur["body"].append(line)
    for sn in out:
        body = "\n".join(sn["body"]).strip("\n")
        fenced = re.fullmatch(r"(`{3,})[^\n]*\n(.*)\n\1", body.strip(), re.S)
        sn["body"] = fenced.group(2) if fenced else body.strip()
    return out


def quick_notes():
    """[{ts, text, line}] newest first."""
    out = []
    for n, line in enumerate(read_lines(QUICK_MD), 1):
        m = re.match(r"- (\d{4}-\d\d-\d\d \d\d:\d\d) · (.*)", line)
        if m:
            out.append({"ts": m.group(1), "text": m.group(2), "line": n})
    return out[::-1]


def add_snippet(title, body):
    fence = "````" if "```" in body else "```"
    prefix = "" if not read_lines(SNIPPETS_MD) else "\n"
    append_text(SNIPPETS_MD, f"{prefix}## {title}\n\n{fence}\n{body.rstrip()}\n{fence}\n")


def add_quick_note(text):
