#!/usr/bin/env bash
# Mark the current kitty tab with what its Claude session is doing, and take
# the mark off again. Called from the Claude Code hooks (mausi-hook). No-op
# outside kitty.
#
#   mausi-mark mark    # waiting on you: "⏳ title", user var claude_wait=1
#   mausi-mark clear   # no longer waiting: title back, claude_wait unset
#   mausi-mark busy    # Claude is working: "▶ title", user var claude_busy=1
#   mausi-mark idle    # Claude stopped: title back, claude_busy unset
#   mausi-mark bg      # idle, but background jobs run: "▷ title", claude_bg=1
#
# mausi-picker and mausi-dash read the user vars.
#
# `clear` runs on every PreToolUse, so it returns straight away unless `mark`
# left a flag file — no remote-control round trips on the hot path. busy and
# idle run once per prompt (UserPromptSubmit, Stop). bg comes from the
# dashboard, which watches for background jobs (no hook fires when they end)
# and also puts a ▶ right that a skipped Stop (Esc) left behind.
[[ -n "${KITTY_WINDOW_ID:-}" && -n "${KITTY_LISTEN_ON:-}" ]] || exit 0

match="id:${KITTY_WINDOW_ID}"
tab="window_id:${KITTY_WINDOW_ID}"  # set-tab-title matches tabs: id: would be a tab id
flag="${XDG_RUNTIME_DIR:-/tmp}/mausi-notify/kitty-marked/${KITTY_WINDOW_ID}"
[[ "${1:-}" == clear && ! -e "$flag" ]] && exit 0

# Base title: the one mausi recorded, else whatever the tab shows now
# minus any marker we left on it earlier.
# own=1 when mausi named the tab (claude_title); else the tab follows its window's
# title, and clearing hands it back to that rather than freezing it.
read -r own base < <(kitty @ ls 2>/dev/null | jq -r --argjson w "$KITTY_WINDOW_ID" '
	.[].tabs[] | select(any(.windows[]; .id == $w)) as $t
	| ($t.windows[] | select(.id == $w) | .user_vars.claude_title) as $c
	| (if $c then "1 " + $c else "0 " + $t.title end)' | head -1)
base="${base#⏳ }"
base="${base#▶ }"
base="${base#▷ }"
base="${base#● }"  # the earlier working mark

title() {  # title <prefix>: "<prefix> base", or the unmarked title for ""
	if [[ -n "$1" ]]; then
		[[ -n "$base" ]] && kitty @ set-tab-title --match "$tab" "$1 $base" >/dev/null 2>&1
	elif [[ "$own" == 1 ]]; then
		kitty @ set-tab-title --match "$tab" "$base" >/dev/null 2>&1
	else
		kitty @ set-tab-title --match "$tab" "" >/dev/null 2>&1  # back to following the window title
	fi
}

case "${1:-}" in
	mark)
		mkdir -p "${flag%/*}"
		touch "$flag"
		kitty @ set-user-vars --match "$match" claude_wait=1 claude_busy claude_bg >/dev/null 2>&1
		title "⏳"
		;;
	clear)
		rm -f "$flag"
		kitty @ set-user-vars --match "$match" claude_wait >/dev/null 2>&1
		title ""
		;;
	busy)
		kitty @ set-user-vars --match "$match" claude_busy=1 claude_bg >/dev/null 2>&1
		title "▶"
		;;
	idle)
		kitty @ set-user-vars --match "$match" claude_busy claude_bg >/dev/null 2>&1
		title ""
		;;
	bg)
		kitty @ set-user-vars --match "$match" claude_busy claude_bg=1 >/dev/null 2>&1
		title "▷"
		;;
esac
exit 0
