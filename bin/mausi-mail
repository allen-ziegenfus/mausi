#!/usr/bin/env python3
"""mausi-mail: the Inbox over IMAP, for mausi's [commands] mail. Listing is
read-only (nothing is marked read). Python 3.9+, standard library only.

    mausi-mail --host imap.example.com --user me@example.com --password-cmd "CMD"
               [--me alias@example.com] [--web URL]
    mausi-mail --host imap.gmail.com --user-cmd "CMD" --token-cmd "CMD" ...

The password is what --password-cmd prints (a keychain or password manager's
command line; use an app password if the account has 2FA), or
$MAUSI_MAIL_PASSWORD. With --token-cmd, a command that prints an OAuth2
access token (for accounts without app passwords; e.g. one that asks GNOME
Online Accounts), it signs in with XOAUTH2 instead. --user-cmd prints the
user name, in place of --user.

Prints {"unread": [...], "messages": [...]}: the last --days days of the
Inbox (default 14), newest first, in the fields mausi's Mail section reads.

    mausi-mail ... --raw MESSAGE-ID      # the whole mail (RFC 822), still unread
    mausi-mail ... --delete MESSAGE-ID   # move it to the trash folder
    mausi-mail ... --search "WORDS"      # mails with all the words, in every folder but
                                         # the trash, spam, drafts (--all-folders: those too)

With --local CMD, a local copy of the mail answers --search and --raw (kept
up to date by something else, e.g. mausi's [mail] sync), when it's there;
else they go to the server. CMD indexes Maildir folders and is run as

    CMD search LIMIT WORD...     # the matching mails' files, newest first, one a line
    CMD file MESSAGE-ID          # that mail's file (nothing if there's none)

--maildir is the account's folder in the copy, for the folder names shown.

Each listing also keeps the listed mails whole in --cache (default
~/.cache/mausi/mail, readable only by you; mails no longer listed are
removed), so --raw is instant for them.
"""
import argparse
import datetime
import hashlib
import email
import email.header
import email.utils
import imaplib
import json
import os
import re
import shlex
import shutil
import ssl
import subprocess
import sys

MAX = 60  # messages fetched at most
CACHE_MAX = 5 << 20  # mails bigger than this (attachments) aren't cached
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "mausi", "mail")


def cache_path(cache, message_id):
    return os.path.join(cache, hashlib.sha1(message_id.encode()).hexdigest() + ".eml")


def cache_sync(imap, cache, listed):
    """Keep the listed mails whole in cache: fetch the missing ones (not too
    big), remove those no longer listed. listed: {message_id: (uid, size)}."""
    os.makedirs(cache, mode=0o700, exist_ok=True)
    os.chmod(cache, 0o700)  # also when it was there already, more open
    want = {cache_path(cache, mid): (uid, size) for mid, (uid, size) in listed.items() if mid}
    for name in os.listdir(cache):
        path = os.path.join(cache, name)
        if name.endswith(".eml") and path not in want:
            os.remove(path)
    missing = [(path, uid) for path, (uid, size) in want.items() if not os.path.exists(path) and size <= CACHE_MAX]
    for i in range(0, len(missing), 10):
        batch = dict((uid, path) for path, uid in missing[i:i + 10])
        _, rows = imap.uid("fetch", b",".join(batch), "(UID BODY.PEEK[])")
        for row in rows:
            if not isinstance(row, tuple):
                continue
            uid = re.search(rb"UID (\d+)", row[0])
            path = batch.get(uid.group(1)) if uid else None
            if path:
                fd = os.open(path + ".part", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "wb") as f:
                    f.write(row[1])
                os.replace(path + ".part", path)


def password(command):
    if os.environ.get("MAUSI_MAIL_PASSWORD"):
        return os.environ["MAUSI_MAIL_PASSWORD"]
    if not command:
        raise SystemExit("no password: give --password-cmd (or set MAUSI_MAIL_PASSWORD)")
    r = subprocess.run(shlex.split(os.path.expanduser(command)), capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        raise SystemExit(f"no password from --password-cmd: {r.stderr.strip()[:200]}")
    return r.stdout.rstrip("\n")


def run_secret(command, flag):
    """What a --*-cmd prints (first line), or exit."""
    r = subprocess.run(shlex.split(os.path.expanduser(command)), capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        raise SystemExit(f"nothing from {flag}: {r.stderr.strip()[:200]}")
    return r.stdout.strip().splitlines()[0]


def text(value):
    parts = []
    for chunk, charset in email.header.decode_header(value or ""):
        if isinstance(chunk, bytes):
            try:
                chunk = chunk.decode(charset or "utf-8", "replace")
            except LookupError:  # a charset Python doesn't know
                chunk = chunk.decode("utf-8", "replace")
        parts.append(chunk)
    return CONTROLS.sub("", re.sub(r"\s+", " ", "".join(parts)).strip())


CONTROLS = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")  # what never leaves here: ESC and the like


def snippet(msg, limit=600):
    """The start of the plain-text body (or the HTML with tags stripped)."""
    for want in ("text/plain", "text/html"):
        for part in msg.walk():
            if part.get_content_type() == want and not part.get_filename():
                try:
                    body = part.get_payload(decode=True).decode(part.get_content_charset() or "utf-8", "replace")
                except (AttributeError, LookupError):
                    continue
                if want == "text/html":
                    body = re.sub(r"(?is)<(script|style).*?</\1>|<[^>]+>", " ", body)
                    body = re.sub(r"&nbsp;|&#160;", " ", body)
                return CONTROLS.sub("", re.sub(r"\s+", " ", body).strip())[:limit]
    return ""


def utf7_name(raw):
    """An IMAP folder name (modified UTF-7, e.g. Caf&AOk-) as text; a
    malformed one stays as it is."""
    import base64
    import binascii
    try:
        return re.sub(r"&([^-]*)-", lambda m: "&" if not m.group(1) else base64.b64decode(
            m.group(1).replace(",", "/") + "=" * (-len(m.group(1)) % 4)).decode("utf-16-be"), raw)
    except (binascii.Error, UnicodeDecodeError, ValueError):
        return raw


MESSAGE_ID_RE = re.compile(r"[^\s\x00-\x1f\x7f\"'\\()<>]+")


def message_id(value):
    """A Message-ID header's id (no <>, folding whitespace removed)."""
    return re.sub(r"\s+", "", value or "").strip("<>")


def safe_id(value):
    """The header's id if it's usable as it is, else ""."""
    mid = message_id(value)
    return mid if MESSAGE_ID_RE.fullmatch(mid or "") else ""


def checked_id(mid):
    """mid if it can go into an IMAP or a local-copy command as it is; ids come
    from mail, so one with spaces, quotes, brackets or control characters
    (an attempt to add commands) is refused."""
    if not mid or not MESSAGE_ID_RE.fullmatch(mid):
        raise SystemExit(f"not a usable Message-ID: {mid!r}")
    return mid


def folders(imap):
    """[(name for SELECT, name as text, flags)] of the selectable folders."""
    out = []
    _, rows = imap.list()
    for row in rows or []:
        if isinstance(row, tuple):  # the name as a literal: (b'(flags) "/" {n}', b'name')
            row = re.sub(rb"\{\d+\}$", b"", row[0]) + b'"' + row[1].replace(b'"', b'\\"') + b'"'
        m = re.match(rb'\(([^)]*)\) (?:"[^"]*"|NIL) (.+)', row or b"")
        if not m or b"\\Noselect" in m.group(1):
            continue
        name = m.group(2).decode()
        bare = name[1:-1] if name.startswith('"') and name.endswith('"') else name
        out.append((name, utf7_name(bare), m.group(1).decode()))
    return out


def trash_folder(imap):
    """The folder flagged \\Trash (its name depends on the account's language)."""
    for name, _, flags in folders(imap):
        if "\\Trash" in flags:
            return name
    raise SystemExit("no trash folder (\\Trash) on the server")


def find(imap, wanted, readonly=True, hint=None):
    """(folder, uid) of the mail: in hint (a folder's name as text) if given,
    else the Inbox first, then every other folder; the folder is left selected."""
    order = [("INBOX", "INBOX")] + [(n, t) for n, t, _ in folders(imap) if t.upper() != "INBOX"]
    if hint:
        order = [f for f in order if f[1] == hint] + [f for f in order if f[1] != hint]
    mid = checked_id(wanted)
    for name, shown in order:
        if imap.select(name, readonly=readonly)[0] != "OK":
            continue
        _, data = imap.uid("search", None, "HEADER", "Message-ID", f'"{mid}"')
        uids = data[0].split() if data and data[0] else []
        if not uids:
            continue
        # HEADER matches substrings: take the mail whose id is exactly this one
        _, rows = imap.uid("fetch", b",".join(uids), "(UID BODY.PEEK[HEADER.FIELDS (MESSAGE-ID)])")
        for r in reversed(rows or []):
            if isinstance(r, tuple):
                got = email.message_from_bytes(r[1]).get("Message-ID")
                uid = re.search(rb"UID (\d+)", r[0])
                if uid and message_id(got) == mid:
                    return shown, uid.group(1)
    raise SystemExit(f"no mail with Message-ID {mid}")


def summary(meta, raw, mine, web, folder=None):
    """One mail as the list shows it (from its flags and its first bytes)."""
    flags = re.search(rb"FLAGS \(([^)]*)\)", meta)
    flags = flags.group(1).decode() if flags else ""
    msg = email.message_from_bytes(raw)
    try:
        when = email.utils.parsedate_to_datetime(msg["Date"]).astimezone()
    except (TypeError, ValueError):
        when = datetime.datetime.now().astimezone()
    name, addr = email.utils.parseaddr(text(msg["From"]))
    to = {x[1].lower() for x in email.utils.getaddresses([text(msg.get("To")), text(msg.get("Cc"))])}
    out = {"from": name or addr, "from_addr": addr, "subject": text(msg["Subject"]) or "(no subject)",
           "date": when.strftime("%Y-%m-%dT%H:%M"), "read": "\\Seen" in flags, "starred": "\\Flagged" in flags,
           "list": bool(msg.get("List-Id") or msg.get("List-Unsubscribe")), "to_me": bool(to & mine),
           # an id that couldn't be used safely (quotes, brackets, spaces) isn't given out at all:
           # it could be typed into a shell or a command
           "message_id": safe_id(msg.get("Message-ID")), "url": web, "body": snippet(msg)}
    if folder:
        out["folder"] = folder
    return out


def criteria(query):
    """IMAP SEARCH keys for the words: each must be in the sender, subject or
    text. One word with non-ASCII letters (ü, é…) can be searched too, in the
    text: imaplib sends it as a literal, after the last key."""
    keys, literal = [], None
    for word in query.split():
        if word.isascii():
            q = '"' + word.replace("\\", "").replace('"', "") + '"'
            keys += ["OR", "OR", "FROM", q, "SUBJECT", q, "TEXT", q]
        elif literal is None:
            literal = word.encode()
        else:  # imaplib sends one literal per command
            print(f"search: “{word}” left out (only one word with non-ASCII letters per server search)",
                  file=sys.stderr)
    if literal is not None:
        keys.append("TEXT")
    return keys, literal


SKIP_FLAGS = ("\\Trash", "\\Junk", "\\Drafts")  # left out of a search unless --all-folders
SKIP_NAMES = re.compile(r"(?i)^(deleted messages|templates)$")
PARALLEL = 6  # connections a search uses at once (each folder costs a round trip or two)


def search(connect, query, mine, web, limit, all_folders=False):
    """The newest mails matching the query, in every folder but the trash,
    spam, drafts and templates (all_folders: those too), searched over
    PARALLEL connections. Only dates are fetched for all the matches; the
    newest `limit` then get their headers (no body: no snippet)."""
    import concurrent.futures
    import queue
    keys, literal = criteria(query)
    if not keys:
        return []
    first = connect()
    todo = [(n, t) for n, t, flags in folders(first)
            if all_folders or not (any(f in flags for f in SKIP_FLAGS) or SKIP_NAMES.match(t))]
    pool = queue.Queue()
    pool.put(first)

    def take():
        try:
            return pool.get_nowait()
        except queue.Empty:
            return connect()

    def one(folder):
        name, shown = folder
        try:
            imap = take()
        except (imaplib.IMAP4.error, OSError):
            return []
        broken = False
        try:
            if imap.select(name, readonly=True)[0] != "OK":
                return []
            if literal is not None:
                imap.literal = literal
                typ, data = imap.uid("search", "CHARSET", "UTF-8", *keys)
            else:
                typ, data = imap.uid("search", None, *keys)
            uids = data[0].split()[-limit:] if typ == "OK" and data and data[0] else []
            if not uids:
                return []
            _, rows = imap.uid("fetch", b",".join(uids), "(UID FLAGS INTERNALDATE BODY.PEEK[HEADER])")
            out = []
            for r in rows:
                if isinstance(r, tuple):
                    m = summary(r[0], r[1], mine, web, shown)
                    when = re.search(rb'INTERNALDATE "([^"]+)"', r[0])
                    try:
                        m["_t"] = datetime.datetime.strptime(when.group(1).decode(), "%d-%b-%Y %H:%M:%S %z").timestamp()
                    except (AttributeError, ValueError):
                        m["_t"] = 0
                    out.append(m)
            return out
        except (imaplib.IMAP4.error, OSError):  # this folder is left out; the connection too
            broken = True
            return []
        finally:
            if broken:
                try:
                    imap.shutdown()
                except OSError:
                    pass
            else:
                pool.put(imap)

    found = []
    with concurrent.futures.ThreadPoolExecutor(PARALLEL) as ex:
        for part in ex.map(one, todo):
            found += part
    while not pool.empty():
        try:
            pool.get_nowait().logout()
        except (imaplib.IMAP4.error, OSError):
            pass
    found.sort(key=lambda m: m.pop("_t", 0), reverse=True)
    return found[:limit]


def local(command, *args):
    r = subprocess.run(command + list(args), capture_output=True, timeout=30)
    if r.returncode != 0:
        raise OSError(r.stderr.decode(errors="replace").strip() or f"{command[0]} failed")
    return r.stdout.decode(errors="replace")


def local_ok(command, maildir):
    return bool(command) and shutil.which(command[0]) and (not maildir or os.path.isdir(maildir))


SKIP_LOCAL = r"trash|deleted messages|deleted items|spam|junk|drafts|templates"  # --skip: the local copy's


def local_search(command, maildir, query, mine, web, limit, all_folders=False, skip=SKIP_LOCAL):
    """--search from the local copy: the files `command search` gives, newest
    first, read here (flags from their Maildir names)."""
    words = query.split()
    if not words:
        return []
    top = os.path.dirname(maildir.rstrip("/")) if maildir else ""
    skip_re = re.compile(rf"(?i)(^|/)({skip})(/|$)")
    found, seen = [], set()
    for path in local(command, "search", str(limit * 4), *words).splitlines():
        box = os.path.dirname(os.path.dirname(path))  # <folder>/{cur,new}/<file>
        under = maildir if maildir and path.startswith(maildir.rstrip("/") + "/") else top
        folder = os.path.relpath(box, under) if under else os.path.basename(box)
        if not all_folders and skip_re.search(folder):
            continue
        try:
            with open(path, "rb") as f:
                head = f.read(65536).split(b"\r\n\r\n", 1)[0].split(b"\n\n", 1)[0]
        except OSError:
            continue
        info = os.path.basename(path).rsplit(":2,", 1)[-1] if ":2," in path else ""
        meta = b"FLAGS (" + (b"\\Seen " if "S" in info else b"") + (b"\\Flagged" if "F" in info else b"") + b")"
        m = summary(meta, head, mine, web, folder)
        if m["message_id"] in seen:
            continue
        seen.add(m["message_id"])
        found.append(m)
        if len(found) >= limit:
            break
    return found


def local_raw(command, message_id):
    """The mail's file from the local copy, or None."""
    files = local(command, "file", checked_id(message_id)).splitlines()
    if files and os.path.exists(files[0]):
        with open(files[0], "rb") as f:
            return f.read()
    return None


def act(imap, a):
    """--raw / --delete: one mail, by its Message-ID, in any folder."""
    if a.raw:
        _, uid = find(imap, a.raw, hint=a.folder)
        _, rows = imap.uid("fetch", uid, "(BODY.PEEK[])")
        sys.stdout.buffer.write(next(r[1] for r in rows if isinstance(r, tuple)))
        return 0
    trash = trash_folder(imap)
    folder, uid = find(imap, a.delete, readonly=False, hint=a.folder)
    if utf7_name(trash.strip('"')) == folder:
        raise SystemExit(f"it's already in {folder}")
    typ, data = imap.uid("move", uid, trash)
    if typ != "OK":
        raise SystemExit(f"move to {trash} failed: {data}")
    try:
        os.remove(cache_path(a.cache, a.delete))
    except OSError:
        pass
    print(f"moved to {utf7_name(trash.strip(chr(34)))}")
    return 0


def main():
    ap = argparse.ArgumentParser(description="The Inbox over IMAP as mausi's mail JSON.")
    ap.add_argument("--host", required=True)
    ap.add_argument("--port", type=int, default=993)
    ap.add_argument("--user", default="")
    ap.add_argument("--user-cmd", default="", help="a command that prints the user name, in place of --user")
    ap.add_argument("--password-cmd", default="", help="a command that prints the password")
    ap.add_argument("--token-cmd", default="", help="a command that prints an OAuth2 access token: XOAUTH2, no password")
    ap.add_argument("--me", action="append", default=[], help="another address of mine, for 'to me' (repeatable)")
    ap.add_argument("--days", type=int, default=14)
    ap.add_argument("--web", default="", help="URL the mail opens at (the webmail), e.g. https://mail.example.com")
    one = ap.add_mutually_exclusive_group()
    one.add_argument("--raw", metavar="MESSAGE-ID", help="print that mail whole (not marked read)")
    one.add_argument("--delete", metavar="MESSAGE-ID", help="move that mail to the trash folder")
    one.add_argument("--search", metavar="WORDS", help="every folder: mails with all the words (sender, subject, text)")
    ap.add_argument("--limit", type=int, default=50, help="most results for --search (default 50)")
    ap.add_argument("--local", default="", help="the local copy's command (see above): --search and --raw use it")
    ap.add_argument("--maildir", default="", help="the account's folder in the local copy, for folder names")
    ap.add_argument("--skip", default=SKIP_LOCAL,
                    help="regex: local-copy folders a search leaves out (trash, spam, drafts; in the account's language)")
    ap.add_argument("--folder", help="for --raw/--delete: the folder it's in (as --search shows it), looked in first")
    ap.add_argument("--all-folders", action="store_true", help="--search the trash, spam, drafts and templates too")
    ap.add_argument("--cache", default=CACHE, help=f"where listed mails are kept whole (default {CACHE}; '' = nowhere)")
    a = ap.parse_args()
    if a.user_cmd and not a.user:
        a.user = run_secret(a.user_cmd, "--user-cmd")
    if not a.user:
        ap.error("give --user or --user-cmd")
    if a.raw and a.cache and os.path.exists(cache_path(a.cache, a.raw)):  # no connection needed
        with open(cache_path(a.cache, a.raw), "rb") as f:
            sys.stdout.buffer.write(f.read())
        return 0
    mine = {a.user.lower(), *(m.lower() for m in a.me)}
    maildir = os.path.realpath(os.path.expanduser(a.maildir)) if a.maildir else ""
    local_cmd = shlex.split(os.path.expanduser(a.local)) if a.local else []
    if local_ok(local_cmd, maildir) and (a.raw or a.search is not None):
        try:
            if a.raw:
                raw = local_raw(local_cmd, a.raw)
                if raw is not None:
                    sys.stdout.buffer.write(raw)
                    return 0
            else:
                found = local_search(local_cmd, maildir, a.search, mine, a.web, a.limit, a.all_folders, a.skip)
                print(json.dumps({"query": a.search, "source": "local", "unread": [m for m in found if not m["read"]],
                                  "messages": found}, ensure_ascii=False))
                return 0
        except (OSError, subprocess.TimeoutExpired) as e:  # the server, then
            print(f"local: {e}", file=sys.stderr)

    token = run_secret(a.token_cmd, "--token-cmd") if a.token_cmd else None
    secret = None if token else password(a.password_cmd)

    def connect():
        imap = imaplib.IMAP4_SSL(a.host, a.port, ssl_context=ssl.create_default_context(), timeout=30)
        if token:
            imap.authenticate("XOAUTH2", lambda _: f"user={a.user}\x01auth=Bearer {token}\x01\x01".encode())
        else:
            imap.login(a.user, secret)
        return imap

    try:
        if a.search is not None:
            found = search(connect, a.search, mine, a.web, a.limit, a.all_folders)
            print(json.dumps({"query": a.search, "unread": [m for m in found if not m["read"]], "messages": found},
                             ensure_ascii=False))
            return 0
        imap = connect()
        if a.raw or a.delete:
            try:
                return act(imap, a)
            finally:
                imap.logout()
        imap.select("INBOX", readonly=True)
        since = (datetime.date.today() - datetime.timedelta(days=a.days)).strftime("%d-%b-%Y")
        _, data = imap.uid("search", None, "SINCE", since)
        uids = data[0].split()[-MAX:]
        messages, listed = [], {}
        if uids:
            _, rows = imap.uid("fetch", b",".join(uids), "(UID FLAGS RFC822.SIZE BODY.PEEK[]<0.20000>)")
            for row in rows:
                if not isinstance(row, tuple):
                    continue
                m = summary(row[0], row[1], mine, a.web)
                uid, size = re.search(rb"UID (\d+)", row[0]), re.search(rb"RFC822.SIZE (\d+)", row[0])
                if uid:
                    listed[m["message_id"]] = (uid.group(1), int(size.group(1)) if size else 0)
                messages.append(m)
            if a.cache:
                try:
                    cache_sync(imap, a.cache, listed)
                except (imaplib.IMAP4.error, OSError) as e:  # the list still counts
                    print(f"cache: {e}", file=sys.stderr)
        imap.logout()
    except (imaplib.IMAP4.error, OSError) as e:
        print(f"IMAP {a.host}: {e}", file=sys.stderr)
        return 1
    messages.sort(key=lambda m: m["date"], reverse=True)
    print(json.dumps({"unread": [m for m in messages if not m["read"]], "messages": messages}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
